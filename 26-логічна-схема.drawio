    <diagram id="p4" name="4 · Ящики — усі кейси">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1360" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p4_t" value="Ящики: наділ, видача, повернення, відправлення, склад" style="text;html=1;fontSize=19;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="20" y="15" width="1300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p4_s" value="Тільки INSERT; сторно = новий стан зі слідом. Баланс людини — МЕРЕЖЕВИЙ (не по точці!)." style="text;html=1;fontSize=11;fontColor=#555555;align=left;" vertex="1" parent="1">
                    <mxGeometry x="20" y="46" width="2040" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p4_al" value="НАДІЛ setCrateAllotment (owner ∧ point):&#xa;• effectiveFrom — ISO (лексичне порівняння effectiveAt)&#xa;• units — ЦІЛЕ ≥ 0&#xa;• причина обовʼязкова, якщо наділ уже є&#xa;Новий запис (історія), баланс не перераховується" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="100" width="380" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="p4_al2" value="наділ &lt; наявного (у людей+дорозі) → ДОЗВОЛЕНО з попередженням, не заборона" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffec99;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="440" y="110" width="380" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p4_cf" value="НАДІЛ КАСИ setCashFloat (owner ∧ point): amount — FINITE + round2 (гроші, не ціле), причина при зміні" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="214" width="380" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p4_is" value="ВИДАЧА issueCrates (actorAt point)&#xa;checkCrateIssue(units, onHand)" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;align=center;fillColor=#fff9db;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="40" y="290" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p4_isb" value="БЛОК:&#xa;• onHand = null (наділу на дату немає) → зникли б з обліку&#xa;• НЕ (int &amp; units&gt;0 &amp; units ≤ max(0,onHand))&#xa;  пробита точка (onHand&lt;0) → max 0, нічого видати&#xa;• deposit без Чешки в довіднику → блок" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffc9c9;strokeColor=#c92a2a;" vertex="1" parent="1">
                    <mxGeometry x="440" y="270" width="420" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4_isd" value="mode = mode ?? crateIssueMode(units): units&gt;50 → receipt, інакше deposit (≤50 завдаток / ≥51 розписка). Ручний mode перемагає" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="378" width="380" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p4_iok1" value="deposit → depositPerUnit=round2(ціна Чешки) знімок; depositTaken → КАСА ЗА ЯЩИКИ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="440" y="378" width="420" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p4_iok2" value="receipt → 0 ₴; receiptNo руками; каса НЕ рухається; у UI «—», не «0,00»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="440" y="432" width="420" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e10" value="ні" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p4_is" target="p4_isb">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e11" value="так" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p4_is" target="p4_isd">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p4_isd" target="p4_iok1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p4_isd" target="p4_iok2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_rt" value="ПОВЕРНЕННЯ returnCrates (actorAt point)&#xa;checkCrateReturn(units, balance)" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;align=center;fillColor=#fff9db;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="40" y="470" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p4_rtb" value="НЕ (int &amp; units&gt;0 &amp; ≤max) → «брала 20, повернути 25 не можна»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffc9c9;strokeColor=#c92a2a;" vertex="1" parent="1">
                    <mxGeometry x="440" y="490" width="420" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p4_rtd" value="balance = crateBalance(supplier) — ПО ЛЮДИНІ, МЕРЕЖЕВО (без фільтра точки!). FIFO allocateCrateReturn (порядок журналу); perUnit — зі ЗНІМКА кожної видачі" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="558" width="380" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p4_rtdg" value="взяв на p1, повернув на p3 → p1.inField=20, p3.inField=−20 (нетто 0). InFieldTable малює червоний банер розбіжності; crateBalance.drift ловить units≠Σalloc" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="440" y="558" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p4_rtc" value="refund ≤ каса за ЯЩИКИ?&#xa;checkCrateRefund (≥0!)" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;align=center;fillColor=#fff9db;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="40" y="650" width="380" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p4_rtcb" value="refund &gt; crateCash → БЛОК. Впирається в касу за ЯЩИКИ і НІКОЛИ в касу за ягоду (refund 0 проходить; berry-payout — &gt;0)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffc9c9;strokeColor=#c92a2a;" vertex="1" parent="1">
                    <mxGeometry x="440" y="650" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e20" value="ні" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p4_rt" target="p4_rtb">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e21" value="так" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p4_rt" target="p4_rtd">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p4_rtd" target="p4_rtc">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e23" value="ні" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p4_rtc" target="p4_rtcb">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_sh" value="ВІДПРАВЛЕННЯ postShipment (actorAt point):&#xa;• date ≤ сьогодні&#xa;• brokenUnits — ЦІЛЕ ≥ 0 (0 валідний)&#xa;• withBerryUnits = знімок рушія (Σ Чешок дня), НЕ поле; receptionCount" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="730" width="380" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4_sh2" value="пізніша квитанція після відправлення → «було 142, стало 145» (warn, тихо не переписує). Два відправлення = прогноз 2-го рейсу. Бій теж їде на базу" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffec99;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="440" y="730" width="420" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p4_st" value="СКЛАД crateStanding (mine: pointId &amp; date≤date, voided виключені):&#xa;• onHand = наділ − inField − atBase (порожні на точці)&#xa;• inField = issued − returned (по точці)&#xa;• atBase = shipped(Σ withBerry+broken) − returnedToPoint(лише accepted перекази, за transferDay=acceptedDate??date)&#xa;• shortfall = inField + atBase — існує НАВІТЬ без наділу (onHand=null); пробите (onHand&lt;0) → червоним, не блок" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="40" y="840" width="820" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p4_vd" value="СТОРНО ящиків voidCrateIssue/Return/Shipment (спільний voidCrateDoc):&#xa;• owner&#xa;• причина непорожня&#xa;• не вже-сторновано (друге сторно — відмова)&#xa;• підпис зі stampOf (сесія), не параметр" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="900" y="100" width="400" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4_vdg" value="«сторнувати видачу, на яку лягло повернення» — блок ЛИШЕ в UI (PersonCrateDocs). Рушій пропустив би → drift" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="900" y="200" width="400" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p4_tp" value="ПЕРЕКАЗИ (що рухають наділ/касу) — стор. 5. accept — єдине, що рухає onHand/atBase" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="900" y="270" width="400" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p4_cp" value="§9.1 клієнтські «Правки» (заплановані, ще НЕ в коді): наділ не встановлено → warn, не блок; приймати всі 25 при 20 узятих (20 у систему, 5 порожніх в обмін)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="900" y="330" width="400" height="80" as="geometry"/>
                </mxCell>
