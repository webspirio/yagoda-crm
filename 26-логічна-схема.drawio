                <mxCell id="p5_e21" value="≠0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p5_s_open" target="p5_s_await">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e22" value="settleShift(owner)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p5_s_await" target="p5_s_closed">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_tsm" value="Переказ база→точка — стани" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="860" y="90" width="300" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p5_tsend" value="sendTransfer (owner ∧ point): cash finite≥0; checkCrateTransfer(crates, atBase) — база повертає лише те, що ТРИМАЄ (atBase, int≥0), не shortfall. Народжується «sent», не рухає нічого" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
