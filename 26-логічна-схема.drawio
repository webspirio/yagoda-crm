                <mxCell id="p3_lg4" value="попередження (дозволяємо)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffec99;strokeColor=#f08c00;" vertex="1" parent="1">
