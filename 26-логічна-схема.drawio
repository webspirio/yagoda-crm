                <mxCell id="p3_w2g" value="§9.2 ТЗ: піддон&gt;50%, дубль&lt;60с — У КОДІ ВІДСУТНІ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="400" y="510" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3_e23" value="warn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;endArrow=open;dashed=1;strokeColor=#adb5bd;" edge="1" parent="1" source="p3_d2" target="p3_w2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_sc" value="дод. ціна ПОЗА межами → ВІДМОВА: bonus→0, рядок за базовою ціною, «потрібен дозвіл керівника». НЕ обрізається до межі" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffc9c9;strokeColor=#c92a2a;" vertex="1" parent="1">
                    <mxGeometry x="780" y="290" width="360" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p3_scg" value="§2.9 ТЗ каже «коригується до межі» (clamp) — код ВІДХИЛЯЄ. clamped-поле мертве" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="780" y="388" width="360" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p3_e26" value="поза межами" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p3_s3" target="p3_sc">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_pm1" value="visitMath: payCap = РАЗОМ. paid = clamp(0, payCap). Видати &gt; РАЗОМ не можна (обрізається)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="780" y="470" width="360" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p3_pm2" value="КАСА ЗА ЯГОДУ — checkBerryPayout(cashLeaving, berryCash): amount&gt;0 &amp; ≤berryCash. НЕ trim — ВЕСЬ ВІЗИТ ВІДХИЛЕНО (undefined). min(·,berryCash) — лише UI-передзаповнення" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffc9c9;strokeColor=#c92a2a;" vertex="1" parent="1">
                    <mxGeometry x="780" y="560" width="360" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p3_pm2n" value="порожня каса НЕ спиняє (guard cashLeaving&gt;0): різниця в залишок, касу відновить переказ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="780" y="660" width="360" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p3_fifo" value="FIFO allocatePayout / openDebts: найстаріший борг першим; кожна алокація памʼятає originDate; кредити (переплата) нетяться до max(0,balance)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="780" y="720" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p3_e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p3_s5" target="p3_pm1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p3_pm1" target="p3_pm2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p3_pm2" target="p3_pm2n">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p3_pm2n" target="p3_fifo">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_r1" value="= РАЗОМ → залишок 0" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="470" width="360" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p3_r2" value="&lt; РАЗОМ → недоплата: debt=amount−split на СЬОГОДНІШНІЙ квитанції (splitPaidAcrossLines)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="532" width="360" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p3_r3" value="надлишок над сьогодні → addPayout(scopePointId): paidToPast=min(max(0,paid−accrued), openTotal) — clamp у СТОРІ, попунктно; закриває старі з originDate" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="604" width="360" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p3_r4" value="0 → усе в залишок; старі дати збережені" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="688" width="360" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p3_e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p3_fifo" target="p3_r1">
                    <mxGeometry relative="1" as="geometry"/>
