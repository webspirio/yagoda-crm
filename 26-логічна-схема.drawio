    <diagram id="p5" name="5 · Каса + зміна + переказ — усі кейси">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1360" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p5_t" value="Каса точки (підзвіт), зміна, переказ база→точка" style="text;html=1;fontSize=19;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="20" y="15" width="1300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p5_s" value="Дві книги в одній шухляді (АЛЕ див. відкрите питання). Гейти: відкрити/рахувати/закрити — operator; закрити з розбіжністю — owner." style="text;html=1;fontSize=11;fontColor=#555555;align=left;" vertex="1" parent="1">
                    <mxGeometry x="20" y="46" width="2140" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p5_two" value="ДВІ КНИГИ, РІЗНІ ВІКНА (cashStanding):&#xa;• openedOn = max(config.cashBookFrom, перший float точки)&#xa;• berryCash = round2(openingBalance@openedOn + cashIn − berryOut); вікно [openedOn … date]&#xa;• crateCash = завдатки взяті − повернені; вікно [−∞ … date] (БЕЗ нижньої межі: завдаток липня лежить у шухляді в серпні)&#xa;• expectedCash = berryCash + crateCash;  floatShortfall = float@date − berryCash&#xa;• cashIn = Σ accepted переказів за transferDay = acceptedDate ?? date;  float=null → «—»&#xa;• розклад дня: paidToday, paidForPastDays, cashInToday" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="40" y="100" width="760" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p5_op" value="openShift (operator ∧ point): openingFloat≥0 (перерахунок на РАНОК, не «має бути»); друга ВІДКРИТА зміна на точці → відмова" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="250" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p5_cnt" value="countCash (серед дня; шухляда з shift.pointId): зміна open; expectedCash — ЗНІМОК; фіксує факт; багато разів" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="354" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p5_cl" value="closeShift (operator ∧ shift.pointId): discrepancy = counted − expected (shiftDiscrepancy)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="458" width="360" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p5_dcl" value="розбіжність = 0? (порогів НЕМАЄ)" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;align=center;fillColor=#fff9db;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="40" y="542" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p5_op" target="p5_cnt">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p5_cnt" target="p5_cl">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p5_cl" target="p5_dcl">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_clc" value="= 0 → «closed», closedBy = приймальник (хто натиснув)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="440" y="470" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p5_cla" value="≠ 0 (будь-яке, навіть 1 коп.) → «awaiting_explanation», closedBy порожній" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffec99;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="440" y="540" width="360" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p5_settle" value="settleShift (owner, пояснення ОБОВʼЯЗКОВЕ): awaiting_explanation → closed; розбіжність ЛИШАЄТЬСЯ (не підганяють); closedBy = керівник" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="440" y="610" width="360" height="70" as="geometry"/>
