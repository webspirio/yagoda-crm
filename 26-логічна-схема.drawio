                    <mxGeometry x="900" y="440" width="400" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p4_lg0" value="крок / потік" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
