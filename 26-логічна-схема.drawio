                </mxCell>
                <mxCell id="p8_lg0" value="крок / потік" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="600" y="476" width="132" height="28" as="geometry"/>
