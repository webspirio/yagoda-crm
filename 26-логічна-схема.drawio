                <mxCell id="p6_e31" value="voidReweigh(owner)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p6_rs1" target="p6_rs2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6_rwn" value="draft — у типі є, але документ народжується одразу posted; чернетка живе у формі, не в сторі. fromSnapshot; status: awaiting-reweigh | summed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
