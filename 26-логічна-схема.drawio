    <diagram id="p9" name="9 · Навігація за роллю + карта екранів">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p9_t" value="17 маршрутів + екран входу, 3 групи меню, доступ за роллю" style="text;html=1;fontSize=19;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="20" y="15" width="1300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p9_s" value="Приховати пункт меню НЕ достатньо (гейт у сторі); але навігація формує щоденний шлях кожної ролі." style="text;html=1;fontSize=11;fontColor=#555555;align=left;" vertex="1" parent="1">
                    <mxGeometry x="20" y="46" width="1640" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p9_gr1" value="Група «Робота на точці» — ОБИДВІ ролі" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="40" y="100" width="760" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="p9_gr1i" value="reception (Прийомка) · crates (Ящики) · day (Каса за день) · pointcash (Каса точки) · prices (Ціни дня — operator лише читає)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="40" y="130" width="760" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p9_gr2" value="Група «Люди та гроші»" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="40" y="190" width="760" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="p9_gr2i" value="suppliers (Постачальники — обидві) · debts (Залишки — обидві) · journal (Журнал — ЛИШЕ owner)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="40" y="220" width="760" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p9_gr3" value="Група «Керівництву» — ЛИШЕ owner" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="40" y="280" width="760" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="p9_gr3i" value="dashboard (Зведення) · cost (Собівартість) · reweigh (Переважування) · network (Середня по мережі) · sheet (Аркуш) · transfers (Перекази) · points (Точки) · refs (Тара і сорти)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="310" width="760" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p9_cross" value="ПЕРЕХРЕСТЯ: меню «Перекази» лише в owner, АЛЕ команди acceptTransfer/disputeTransfer — operator: точка приймає/оспорює переказ на екрані «Каса точки» (pointcash), не на «Переказах»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="40" y="390" width="760" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p9_supcard" value="Маршрут supplier (картка) — БЕЗ пункту меню; відкривається зі списку «Постачальники»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="40" y="470" width="760" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p9_appn" value="App: гейт на !user (не !session) — реєстр міг змінитися (resetDemo). Suspense+lazy для керівницьких чанків; ErrorBoundary key=route (самолікування впалого чанка); SignInPage у головному чанку; Toaster в обох гілках" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="40" y="530" width="760" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p9_scr" value="Хто на чому сидить" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="900" y="100" width="700" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="p9_opflow" value="ПРИЙМАЛЬНИК (одна своя точка): вхід → reception; протягом дня crates / day / pointcash / prices(читання) / suppliers / debts. Приймає перекази на pointcash." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="900" y="130" width="700" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p9_owflow" value="КЕРІВНИК (усі точки): вхід → dashboard. Ставить ціни (prices), наділи (crates/pointcash), шле перекази (transfers), переважує (reweigh), рахує собівартість (cost), дивиться network/sheet/journal, закриває зміни з розбіжністю, керує points/refs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="900" y="230" width="700" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p9_lg_t" value="Легенда" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="900" y="360" width="700" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p9_lg0" value="крок / потік" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
