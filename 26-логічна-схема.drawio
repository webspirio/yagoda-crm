    <diagram id="p8" name="8 · Постачальники — кейси">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1180" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p8_t" value="Життєвий цикл постачальника і довідник людей" style="text;html=1;fontSize=19;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="20" y="15" width="1300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p8_s" value="Багатий домен ТЗ. Багато правил ще НЕ реалізовано (рожеве) або поза MVP." style="text;html=1;fontSize=11;fontColor=#555555;align=left;" vertex="1" parent="1">
                    <mxGeometry x="20" y="46" width="1940" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p8_c1" value="Людина = ЗАПИС довідника, не текст. Прізвище набрати неможливо — лише вибір зі списку; «не знайдено» не існує — заводять карткою прямо з прийомки (ПС-01/14)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="100" width="520" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p8_c2" value="Пошук за прізвищем АБО селом одночасно; у рядку видно маркер і суму відкритого залишку ДО вибору (ПС-10/11)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="184" width="520" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p8_c3" value="Маркер ОПТ / Фермер / без позначки — взаємовиключний, ставить/міняє ПРИЙМАЛЬНИК без погодження (updateSupplier БЕЗ гейта). Підказка «додайте дод. ціну» — базову ціну НЕ міняє, надбавку НЕ підставляє (ПС-22/25/27)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="268" width="520" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p8_c4" value="Борг ПОПУНКТНИЙ (supplierBalanceAt по activePointId): борг на одній точці не забрати на іншій. Один запис людини + попунктні книги (§3.9)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="40" y="362" width="520" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p8_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p8_c1" target="p8_c2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p8_c2" target="p8_c3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p8_c3" target="p8_c4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8_card" value="КАРТКА ЛЮДИНИ (§3.10): маркер · село · домашня точка · телефон; плитки (здач/кг/нараховано/залишок); розклад по точках; ВІДКРИТІ ЗАЛИШКИ порядково (не однією сумою); історія здач+виплат одним потоком — кожна виплата показує, яку ягоду закрила" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="600" y="110" width="420" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p8_top" value="ТОП ЗДАВАЛЬНИКІВ (owner, OwnerTable): село·прізвище·вага·основний ТОВАР·маркер; сорт. за вагою↓ + перемикач «за сумою»; вага по ВСІХ пунктах; ФІЛЬТРА за маркером НЕМАЄ (клієнт відмовився)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="600" y="240" width="420" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p8_price8" value="ЦІНИ: ключ ціни = СОРТ, звітність = ТОВАР; append-only, остання за time; «загальна» = кнопка «поставити всім active&amp;reception пунктам», СКЛАД окремо (вища ціна); товар без активного/цінового сорту приймальнику не показується" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="600" y="340" width="420" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p8_gh" value="Правила ТЗ, ще НЕ в коді / поза MVP" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="80" width="420" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p8_gp1" value="Село — ТЗ §5.3 «лише зі списку»; у коді ВІЛЬНИЙ текст (Input). Розбіжність" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="110" width="420" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p8_gp2" value="Телефон — примітка §5.7: обовʼязкове поле + чекбокс «без номера»→null. У коді: опційний вільний текст, чекбокса немає" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="180" width="420" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p8_gp3" value="Дублікати на вводі ПС-15…19 (розпізнати «інша людина», запамʼятати назавжди) — НЕ реалізовано. Сід сіє 25 близнюків/≥23 написання для майбутнього екрана" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="250" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p8_gp4" value="Обʼєднання дублікатів §5.5 (owner, 5 кроків: головний→канонічні поля→перегляд→КОНФЛІКТИ→причина; сума боргу не змінюється; незворотне) — ПОЗА MVP" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="326" width="420" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p8_gp5" value="Видалення §5.6 → неактивна картка (is_active) — НЕ реалізовано (немає поля/команди)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="412" width="420" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p8_gp6" value="Пошук за номером телефону (примітка §5.4/§5.7) — план на майбутнє, ще немає" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="482" width="420" height="54" as="geometry"/>
                </mxCell>
