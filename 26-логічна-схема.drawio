                <mxCell id="p4_lg6" value="стан (машина станів)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;align=center;fillColor=#d0bfff;strokeColor=#7048e8;" vertex="1" parent="1">
