    <diagram id="p7" name="7 · Доступ, ролі, сесія — усі кейси">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1500" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p7_t" value="Хто за компʼютером, ролі, гейти (роль + точка), persist" style="text;html=1;fontSize=19;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="20" y="15" width="1300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p7_s" value="auth.ts — окрема вісь від грошей. Гейт у сторі, не лише «сховати меню». Таблиця гейтів нижче — з коду." style="text;html=1;fontSize=11;fontColor=#555555;align=left;" vertex="1" parent="1">
                    <mxGeometry x="20" y="46" width="2240" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p7_start" value="Відкриття / перезавантаження" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="100" width="320" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p7_g0" value="user є? sessionUser(users, session)" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;align=center;fillColor=#fff9db;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="40" y="170" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p7_signin" value="Екран входу: login + secret → signIn → authenticate (auth-mock)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="266" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p7_ag" value="ok?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;align=center;fillColor=#fff9db;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="40" y="342" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p7_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p7_start" target="p7_g0">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p7_g0" target="p7_signin">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p7_signin" target="p7_ag">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_reh" value="rehydrate merge (21 ключ; session ×2, activePointId ×2 звуження; guard порожнього/null payload перед усіма): session дійсна ЛИШЕ якщо isSession(payload) І userIds.has(userId) (Р4-6) → інакше null (решта ключів → свіжий сід). activePointId: зламаний operator (rawPoint≠pointId) → «» (програє); решта, у т.ч. owner → rawPoint без змін. owner→«all» робить лише scopeAfterSignIn (вхід), НЕ merge" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="400" y="90" width="540" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p7_e10" value="session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=8;endArrow=open;dashed=1;strokeColor=#adb5bd;" edge="1" parent="1" source="p7_reh" target="p7_g0">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_fail" value="reason: unknown-login | wrong-secret | no-account. Тексти на екрані. login нормалізується (trim+lower); секрет — чутливий до регістру/пробілів. ACCOUNTS(login) окремо від users → no-account, коли секрет збігся, а User немає" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffc9c9;strokeColor=#c92a2a;" vertex="1" parent="1">
                    <mxGeometry x="400" y="300" width="420" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p7_e12" value="ні" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p7_ag" target="p7_fail">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_scope" value="scopeAfterSignIn: owner → «all» + dashboard; operator → своя точка (pointId ?? «») + reception. signIn також ставить scope + робить 2-гу перевірку no-account" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="40" y="470" width="360" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p7_e14" value="так" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p7_ag" target="p7_scope">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_shell" value="Оболонка + навігація за роллю (стор. 8-нав). Роль ПОХІДНА: roleOf(users, session); null → найсуворіше (нічого)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="900" y="90" width="420" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p7_e16" value="так" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p7_g0" target="p7_shell">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_e17" value="ні" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p7_g0" target="p7_signin">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7_out" value="signOut → session=null + route→reception. Заміна касира = Вийти → Вхід під іншим (НЕ перемикач). countedBy/closedBy = хто НАТИСНУВ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="900" y="180" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p7_sess" value="session {userId, startedDate=businessToday, startedTime=годинник пристрою} — токена немає (форма мока)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="900" y="260" width="420" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p7_nots" value="НЕ захист (22-tz §17.2): пароль звіряє той самий браузер; реєстр і сесія в одному localStorage; секрет лише в auth-mock.ts (на місці сервера)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e5dbff;strokeColor=#7048e8;fontColor=#5f3dc4;" vertex="1" parent="1">
                    <mxGeometry x="900" y="330" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p7_gt" value="ГЕЙТ КОЖНОЇ КОМАНДИ (з коду): роль ∧/∨ точка" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="40" y="580" width="880" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p7_g_role" value="ГЕЙТ РОЛІ (17 команд):&#xa;owner (12): setPrice, setPriceEverywhere, setCrateAllotment*, setCashFloat*, addReweigh, voidReweigh, sendTransfer*, voidTransfer, voidCrateIssue/Return/Shipment (через voidCrateDoc), settleShift&#xa;operator (5): acceptTransfer*, disputeTransfer*, openShift*, countCash*, closeShift*&#xa;(* = ще й точка → BOTH)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffec99;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="40" y="610" width="430" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p7_g_point" value="ГЕЙТ ТОЧКИ actorAt/canActOnPoint (14 команд):&#xa;BOTH (8, роль∧точка): setCrateAllotment, setCashFloat, sendTransfer, acceptTransfer, disputeTransfer, openShift, countCash, closeShift&#xa;ТІЛЬКИ точка (6): addVisit, addPayout, addExpense, issueCrates, returnCrates, postShipment&#xa;(owner/operator згорнуто в canActOnPoint — окремого рольового рядка немає)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffec99;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="490" y="610" width="430" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p7_g_none" value="БЕЗ гейта (UI-only або жодного): addSupplier, updateSupplier, updateTareType, updateSettings, removeExpense, setExpensePolicy, syncAll, resetDemo(читає сесію лише для scope). setActivePoint — окремий inline-гейт точки. go/setOnline/setWorkDate — жодного. Queries — read-only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="40" y="770" width="880" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p7_g_gap" value="ЛАТЕНТНІ ДІРИ: addExpense — коментар/§10.2 кажуть «лише керівник», у коді лише точка (operator міг би). updateTareType/updateSettings — §10.2 owner, у коді без гейта. Сторно квитанції прийомки (§10.2) — команди взагалі немає" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="40" y="850" width="880" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p7_key7" value="КЛЮЧОВЕ: гейт точки НІКОЛИ не заміняє гейт ролі — canActOnPoint(owner,·)=true. Порядок: спершу роль, потім точка. Підпис = actor (імʼя), null → відмова" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="40" y="920" width="880" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p7_lg_t" value="Легенда" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="960" y="610" width="420" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p7_lg0" value="крок / потік" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="960" y="636" width="132" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p7_lg1" value="рішення" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;align=center;fillColor=#fff9db;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="1100" y="636" width="132" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p7_lg2" value="заборона (відмова)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffc9c9;strokeColor=#c92a2a;" vertex="1" parent="1">
                    <mxGeometry x="1240" y="636" width="132" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p7_lg3" value="результат / інваріант" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="960" y="670" width="132" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p7_lg4" value="попередження (дозволяємо)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffec99;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="1100" y="670" width="132" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p7_lg5" value="нотатка / механізм" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="1240" y="670" width="132" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p7_lg6" value="стан (машина станів)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;align=center;fillColor=#d0bfff;strokeColor=#7048e8;" vertex="1" parent="1">
                    <mxGeometry x="960" y="704" width="132" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p7_lg7" value="ТЗ ≠ код / не реалізовано / поза MVP" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
