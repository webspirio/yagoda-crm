                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e33" value="void" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p5_s_dis" target="p5_s_void">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p5_tsend" target="p5_s_sent">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_tacc" value="acceptTransfer (operator ∧ point, лише зі «sent», один раз):&#xa;+cash → каса за ягоду; +crates → onHand (порожні), atBase↓; НАДІЛ НЕ міняється; зараховано ДНЕМ ПРИЙНЯТТЯ (acceptedDate). Owner «Прийняв» за точку не може" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="860" y="440" width="420" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p5_tdis" value="disputeTransfer (operator ∧ point, причина): reportedCrates/reportedCash — ЛИШЕ інформація, у формули НЕ входить. Точка далі read-only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="860" y="540" width="420" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p5_tcorr" value="Закриває СПІРНИЙ керівник: voidTransfer (owner, причина; зі sent/accepted/disputed) + новий sendTransfer({correctionOf}). Виправлені числа входять у формулу" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="860" y="630" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p5_s_acc" target="p5_tacc">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p5_s_dis" target="p5_tdis">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_owed" value="ТАБЛИЦЯ «скільки мережа винна точкам» owedToPoints → PointDebtRow{pointId, float, berryCash, owed(=floatShortfall), crateShortfall}; РАЗОМ = sum(owed). Стан переказу — окрема колонка (stateOf у сторінці)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="830" width="760" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p5_owedn" value="Точки БЕЗ наділу каси відсіює СТОРІНКА (TransfersPage), не рушій (owedToPoints віддає owed=null)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="40" y="930" width="760" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p5_mov" value="Касу за ягоду рухають ЛИШЕ: виплати (−) і прийняті перекази (+). Ручної видачі «не за ягоду» немає; інкасації немає; витрати дня касу НЕ рухають; наділ каси/ящиків — обчислювані, поля вводу немає (I70)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="860" y="830" width="420" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p5_oq" value="ВІДКРИТЕ ПИТАННЯ: §1:144 і §7.6:1004 кажуть «гроші за ягоду і за ящики НЕ в одній шухляді». Код = ОДНА шухляда (expectedCash=berryCash+crateCash, одне countedCash). Не вирішено" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e5dbff;strokeColor=#7048e8;fontColor=#5f3dc4;" vertex="1" parent="1">
                    <mxGeometry x="860" y="930" width="420" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p5_lg_t" value="Легенда" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1000" width="760" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p5_lg0" value="крок / потік" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1026" width="245" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p5_lg1" value="рішення" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;align=center;fillColor=#fff9db;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="293" y="1026" width="245" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p5_lg2" value="заборона (відмова)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffc9c9;strokeColor=#c92a2a;" vertex="1" parent="1">
                    <mxGeometry x="546" y="1026" width="245" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p5_lg3" value="результат / інваріант" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1060" width="245" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p5_lg4" value="попередження (дозволяємо)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#ffec99;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="293" y="1060" width="245" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p5_lg5" value="нотатка / механізм" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="546" y="1060" width="245" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p5_lg6" value="стан (машина станів)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;align=center;fillColor=#d0bfff;strokeColor=#7048e8;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1094" width="245" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p5_lg7" value="ТЗ ≠ код / не реалізовано / поза MVP" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="293" y="1094" width="245" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p5_lg8" value="відкрите питання замовнику" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e5dbff;strokeColor=#7048e8;fontColor=#5f3dc4;" vertex="1" parent="1">
                    <mxGeometry x="546" y="1094" width="245" height="28" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="p6" name="6 · База: переважування, собівартість, звіти">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p6_t" value="База — переважування, недостача/надлишок, собівартість, розподіл, мережа, аркуш, зведення, журнал" style="text;html=1;fontSize=19;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="20" y="15" width="1300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p6_s" value="Гейт переважування/сторно — РОЛЬ owner (точки немає). Витрати: addExpense — лише точка; removeExpense/policy — без гейта. День = ДЕНЬ ЯГОДИ." style="text;html=1;fontSize=11;fontColor=#555555;align=left;" vertex="1" parent="1">
                    <mxGeometry x="20" y="46" width="2140" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p6_pd" value="productDay(date, point): згортає квитанції у рядки ТОВАРУ {kgPoint, paid=Σamount, avgPoint НЕМОКРУГЛ, lineCount}, сорт. за вагою↓" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="100" width="400" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6_rw" value="ПЕРЕВАЖУВАННЯ addReweigh (owner; ТОЧКОВОГО гейта НЕМАЄ):&#xa;• berryDate = день ЯГОДИ (партія 04.08, важена 05.08 → 04.08)&#xa;• snapshot = productDay(...) РАЗ (avgPoint немокругл; paid = kgPoint×avgPoint)&#xa;• народжується «posted» (draft у типі є, документа немає); джерело — лише reception-пункти" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="184" width="400" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="p6_nd" value="НЕДОСТАЧА (синтез. рядок shortfall, у стані немає): по ТОВАРУ; shortKg = kgBase − kgPoint (відʼємний на недостачі); shortfallTotal = −Σ shortUah (додатний у pool). Звірка ВИДНА до проведення" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="40" y="304" width="400" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p6_cost" value="СОБІВАРТІСТЬ costOfDay:&#xa;• pool = Σ manual-витрат + shortfallTotal&#xa;• rate = pool / kgBase (переважена вага) → на ВСІ товари (напр. 5460÷854=6,39)&#xa;• на товар: avgPoint («було») і avgFinal («собівартість»)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="408" width="400" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="p6_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p6_pd" target="p6_rw">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p6_rw" target="p6_nd">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p6_nd" target="p6_cost">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6_over" value="НАДЛИШОК — реалізовано і протестовано (не «неможливо»): pool&lt;0, allocateByLargestRemainder симетрично, I47 «так буває тільки при надлишку», UI «Надлишок»" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="480" y="180" width="400" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p6_overg" value="§8.2 клієнтська «Правка»: «надлишок неможливий, функціонал не потрібен» — суперечить коду" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="480" y="268" width="400" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p6_rwv" value="СТОРНО voidReweigh (owner, причина): posted → voided (слід); друге сторно — відмова; неіснуючий id — відмова" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="480" y="330" width="400" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p6_alloc" value="РОЗПОДІЛ allocateByLargestRemainder: pool по товарах у ЦІЛИХ копійках (ваги: грами для byWeight, копійки для byValue, 1/0 для singleProduct), найбільший залишок, Σ = pool точно, симетрично для pool&lt;0" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="480" y="420" width="400" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p6_pol" value="ExpensePolicy (належить ДНЮ, заднім числом не міняється):&#xa;basis: byWeight (дефолт) | byValue&#xa;singleProduct: ОКРЕМЕ поле, не третій basis" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;align=center;fillColor=#fff9db;strokeColor=#f08c00;" vertex="1" parent="1">
                    <mxGeometry x="40" y="540" width="400" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p6_polg" value="singleProduct: якщо товар того дня не важили → тихий fallback на byWeight з warn «policy-fallback»; результат рапортує ФАКТИЧНИЙ basis" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="480" y="540" width="400" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6_e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p6_cost" target="p6_over">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p6_cost" target="p6_rwv">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p6_cost" target="p6_alloc">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6_e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p6_cost" target="p6_pol">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6_e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=block;strokeColor=#495057;" edge="1" parent="1" source="p6_pol" target="p6_polg">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6_exp" value="ВИТРАТИ addExpense (actorAt point; kind лише manual, shortfall→відмова; касу НЕ рухає). removeExpense — виняток-видалення. setExpensePolicy — upsert" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="650" width="400" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p6_expg" value="addExpense у СТОРІ гейтований лише точкою; «лише керівник» (§8.3/§10.2) — тільки в UI. removeExpense і setExpensePolicy — БЕЗ гейта взагалі" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;dashed=1;dashPattern=6 4;fillColor=#fff0f6;strokeColor=#e64980;fontColor=#a61e4d;" vertex="1" parent="1">
                    <mxGeometry x="480" y="650" width="400" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6_rep" value="ЗВІТИ" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="40" y="760" width="300" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p6_net" value="СЕРЕДНЯ ПО МЕРЕЖІ networkAverage: сума ÷ вага (зважена), НІКОЛИ середнє з середніх. Порожня клітинка (kgBase≤0 або avg=null) ≠ 0. База включена як selfWeighed (kgBase=kgPoint). + reconciliation/awaitingReweigh" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="40" y="790" width="400" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p6_sheet" value="АРКУШ КЕРІВНИКА: 4 колонки (товар·вага·₴/кг·сума); ₴/кг = сума÷вага; сходиться до копійки. Показує лише банер неповноти (!reconciliation.ok), НЕ список порушень" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#d3f9d8;strokeColor=#2f9e44;" vertex="1" parent="1">
                    <mxGeometry x="480" y="790" width="400" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p6_viol" value="Список Violation[] (I42 block, I45/46/47/49/50/51/55) — на NetworkAverage і CostOfDay, НЕ на Аркуші. warns: policy-fallback, не-перезважено, день змінено, поріг недостачі 3%" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="480" y="880" width="400" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6_svod" value="ЗВЕДЕННЯ (Dashboard): періоди 7/14/30/сезон; 5 плиток (вага·нараховано·видано·залишок·середня); нерозкриті точки = картка «+N у реєстрі», не рядки з нулями; від фільтра не залежить" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="40" y="890" width="400" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p6_jrn" value="ЖУРНАЛ = журнал ПРИЙОМОК (лише receptions, з фільтрами). Журналу подій/аудиту НЕМАЄ — слід лише підпис+час на кожному документі" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
                    <mxGeometry x="40" y="970" width="400" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6_rwsm" value="Переважування — стани" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="900" y="100" width="300" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p6_rs1" value="posted" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;align=center;fillColor=#d0bfff;strokeColor=#7048e8;" vertex="1" parent="1">
                    <mxGeometry x="940" y="130" width="220" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p6_rs2" value="voided" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;align=center;fillColor=#d0bfff;strokeColor=#7048e8;" vertex="1" parent="1">
                    <mxGeometry x="940" y="200" width="220" height="44" as="geometry"/>
