                <mxCell id="p6_inv6" value="Інваріант дня (DayPage): reconcileDay.drift = Σ(amount−paid−debt); нараховано = видано за сьогодні + приріст боргів" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=3;spacingBottom=3;fillColor=#f1f3f5;strokeColor=#868e96;" vertex="1" parent="1">
