{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "nodenext",
    "skipLibCheck": true,
    "noEmit": true,
    "moduleDetection": "force",

    /* The verification layer is plain .mjs so it needs no build step, but it must not
       be the one untypechecked corner of the repo — it is the code that decides whether
       everything else is green. JSDoc carries the types. */
    "allowJs": true,
    "checkJs": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts/**/*.mjs", ".claude/hooks/**/*.mjs"]
}
