// Ягода CRM — схема БД (чернетка). Діаграма: 28-db-schema.drawio, стиль: 28-db-schema.md.
// Джерело правил — 26-rules-by-example.md; посилання «§N» у нотатках ведуть саме туди,
// «правка N» — у 26-правки-і-запитання.md.
//
// Це НЕ 27-entities.dbml: там інша модель (text-ключі, пари бізнес-дата/час, berries).
// Тут — uuid, timestamp і ціна дня журналом на трійці (день, точка, сорт).
//
// Конвенції, зафіксовані навмисно:
//   * гроші numeric(12,2), ціни за кг numeric(10,2), ваги numeric(10,2);
//   * знімок замість перерахунку: те, що надруковано на папері, не рухається (§2.7);
//   * сторно — це поля void_*, а не DELETE; виправлення — новий документ (§9.3);
//   * похідні суми (залишок, «Разом») НЕ зберігаються — їх рахують (§3.2).
//
// Іменування (перейменовано 02.09.2026, причини записані, щоб їх не «полагодили» назад):
//   * intakes, а НЕ receipts: «receipt» уже зайняте розпискою за ящики
//     (crate_issuances.receipt_no, §6.4). Два різні документи одним словом — гірше.
//     І не receptions: англійською це стійка або прийом-вечірка, не прийомка.
//   * shift_grade_prices, а НЕ shift_product_settings: таблиця тримає ЦІНУ дня, а не
//     «налаштування», і ключ у неї СОРТ, не товар — §4.1 робить цю різницю несучою.
//   * crate_issuances, а НЕ crate_issues: «issue» першим значенням читається як
//     «проблема/тікет».
//   * intake_item_tare_types — у множині, як решта 16 таблиць, і повним іменем
//     звʼязки на tare_types.
//   * units скрізь, де лічильник: у чотирьох таблицях одне слово, і жодного `count`,
//     який у запиті читається як виклик функції.
//   * user_role = point_operator | network_owner, а НЕ point_manager | network_admin:
//     колишні значення називали людину НА ТОЧЦІ «менеджером», а керівника мережі —
//     «адміністратором». §10.1 знає рівно дві ролі: приймальник і керівник.
//   * grade_prices, а НЕ shift_grade_prices: ціну виставляють о 07:10, а зміну відкривають
//     о 07:30 (§1) — ціна не може мати NOT NULL shift_id. І UNIQUE(shift, сорт) забороняв
//     ІСТОРІЮ, якої §4.2 вимагає дослівно: «записи не перетираються — додаються».
//   * cash_counts тримає ВСІ три моменти перерахунку (opening | midday | closing), а не
//     лише той, що серед дня: суми відкриття й закриття полями shifts дали б 8 колонок і
//     другий механізм для жесту, який §7.6 уже вимагає окремим документом.
// Перегляд: dbdiagram.io або `npx @dbml/cli dbml2sql 28-db-schema.dbml --postgres`.

Project yagoda_crm {
  database_type: 'PostgreSQL'
  Note: 'Прийомка ягоди: мережа пунктів, зміна як робочий день точки, борг постачальника і ящики як завдаток.'
}

/* ------------------------------ enum-и ------------------------------ */

Enum user_role {
  network_owner
  point_operator
}

Enum supplier_kind {
  none
  wholesale
  farmer
}

Enum crate_issuance_mode {
  deposit
  receipt
}

Enum point_kind {
  reception
  base
}

Enum shift_status {
  open
  awaiting_explanation
  closed
}

Enum cash_book {
  berry
  crates
}

Enum cash_count_kind {
  opening
  midday
  closing
}

Enum transfer_status {
  sent
  accepted
  disputed
  void
}

/* --------------------------- мережа і люди --------------------------- */

Table users {
  id uuid [pk]

  first_name varchar [not null]
  last_name varchar [not null]
  login varchar [unique, not null]
  password_hash varchar [not null]

  role user_role [not null]

  collection_point_id uuid [ref: > collection_points.id]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: 'Вхід за login, не за e-mail (правка в діаграмі 03.09.2026): адреси в приймальників може не бути взагалі, а логін на точці — це те, що людина справді набирає. UNIQUE стоїть на login і ТІЛЬКИ на ньому: унікальний індекс по хешу пароля відхиляв би другого користувача з тим самим паролем, тобто сам факт збігу ставав би видимим ззовні. Поле зветься password_hash, а не password, бо назва — єдине місце, де схема каже, що зберігати треба хеш; §17.2 при цьому нагадує, що пароль, який звіряють на самій точці, не підтверджує нічого. Це поле скасувало рядок 28-tables.md «Пароля немає навмисно» — причина скасування за власником, тут записано лише сам факт.'
}

Table collection_points {
  id uuid [pk]

  name varchar [not null]

  kind point_kind [not null, default: 'reception']

  is_active boolean [not null, default: true]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: '§4.8 — склад це звичайний пункт прийому зі своєю, вищою ціною, якого жест «поставити всім» НЕ чіпає; §8.1 — переважують НА БАЗІ, і документ розрізняє пункт, ЗВІДКИ приїхала ягода, від бази, ДЕ зважували. Без kind ні одне, ні друге не виражається. target_cash і target_crates ЗВІДСИ ПРИБРАНІ (03.09.2026): §6.1 каже «цільове значення — це історія, а не число», а default 0 робив «не задано» нерозрізненним від нуля — тоді як §6.9 вимагає «—», а не нуль, і §7.10 — щоб точка без цільового значення каси не потрапляла в таблицю боргу мережі взагалі. Історія живе в cash_floats і crate_allotments.'
}

Table shifts {
  id uuid [pk]

  collection_point_id uuid [not null, ref: > collection_points.id]

  opened_by_user_id uuid [not null, ref: > users.id]
  closed_by_user_id uuid [ref: > users.id]

  business_date date [not null]

  opened_at timestamp [not null]
  closed_at timestamp

  status shift_status [not null, default: 'open']

  explanation text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (collection_point_id) [unique]
    (collection_point_id, business_date)
  }

  Note: 'ЧАСТКОВИЙ унікальний індекс: UNIQUE (collection_point_id) WHERE closed_at IS NULL — DBML часткових індексів не виражає, тому в SQL його дописують руками. §7.8: дві відкриті зміни це дві книги на одну шухляду, і хто прорахувався, буде не видно. §10.3 — відкриває і закриває зміну ПРИЙМАЛЬНИК; §7.7 + правка 2 — при розбіжності закриває КЕРІВНИК, обовʼязково з explanation, і розбіжність у документі лишається, її не підганяють. Порогів «допустимої» розбіжності немає: не зійшлося на копійку — те саме, що на 350 ₴. Сум каси тут НЕМАЄ: усі три перерахунки лежать у cash_counts.'
}

/* ------------------------------ довідники ------------------------------ */

Table villages {
  id uuid [pk]

  name varchar [not null, unique]

  is_active boolean [not null, default: true]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: '§5.3 — село ВИБИРАЄТЬСЯ зі списку, вільний текст заборонений. У книзі клієнта одне село написане 4 способами: «копайгород» 571 рядок, «Копайгород» 175, «Копайгород » з пробілом 45, «Копай». Довідник — єдине, що це зупиняє.'
}

Table suppliers {
  id uuid [pk]

  collection_point_id uuid [not null, ref: > collection_points.id]

  first_name varchar [not null]
  last_name varchar [not null]

  village_id uuid [not null, ref: > villages.id]

  phone varchar
  note text

  kind supplier_kind [not null, default: 'none']

  is_active boolean [not null, default: true]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (collection_point_id, phone) [unique]
    (collection_point_id, last_name)
  }

  Note: '§3.9 — запис прибитий до ТОЧКИ: людина, яка возить на дві точки, заводиться на кожній окремо, і борг з однієї не гаситься на іншій. §5.6 — видалення немає, тільки is_active. §5.7 + правка 8 — phone null дозволено лише через явний чекбокс «без номеру телефону» на формі; окремого поля під цей факт немає навмисно. Пошук за телефоном (правка 5) — звідси унікальність у межах точки. §5.4 і §5.5 (розпізнавання й обʼєднання дублікатів) скасовані правками 5 і 6, тому таблиць під них тут НЕМАЄ.'
}

Table products {
  id uuid [pk]

  name varchar [not null, unique]

  display_order int

  is_active boolean [not null, default: true]

  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table product_grades {
  id uuid [pk]

  product_id uuid [not null, ref: > products.id]

  name varchar [not null]
  // Наприклад:
  // 1 сорт
  // 2 сорт
  // Екстра

  display_order int

  is_active boolean [not null, default: true]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (product_id, name) [unique]
  }

  Note: '§4.1 — ключ ціни це СОРТ, ключ звітності — товар. «ОПТ» серед прикладів НЕ СТОЇТЬ навмисно (рішення 02.09.2026): у 26-rules-by-example.md це слово трапляється в десяти рядках і ЖОДНОГО разу як сорт — тільки як маркер на людині, suppliers.kind = wholesale (§2.11). Сорт «ОПТ» із власною ціною дня дав би ту саму надбавку двічі: раз ціною дня, раз через intake_items.bonus, — і правило §2.11 «базова ціна від маркера не залежить ніколи» трималося б лише домовленістю. Твердження прийшло зі старої моделі (27-entities.dbml, berries.wholesale) і скасоване.'
}

Table tare_types {
  id uuid [pk]

  name varchar [not null, unique]

  weight_kg numeric(10,2) [not null]
  deposit_price numeric(12,2) [not null]

  is_crate boolean [not null, default: false]

  is_active boolean [not null, default: true]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: '§2.5 — вага тари підставляється сама. Обидва числа РЕДАГУЮТЬСЯ керівником, тому і intake_items.tare_weight_kg, і crate_issuances.deposit_per_unit є знімками (§2.7). is_crate — яка тара вважається «ящиком» для цільового значення й завдатків; ЗАПИТАННЯ 12 (чи «Ящик» і «Чешка» одна одиниця) не закрите.'
}

/* ------------------------------ ціни дня ------------------------------ */

Table grade_prices {
  id uuid [pk]

  business_date       date [not null]
  collection_point_id uuid [not null, ref: > collection_points.id]
  product_grade_id    uuid [not null, ref: > product_grades.id]

  base_price numeric(10,2) [not null]

  set_at         timestamp [not null]
  set_by_user_id uuid [not null, ref: > users.id]
  reason         text

  created_at timestamp [not null]

  indexes {
    (collection_point_id, business_date, product_grade_id, set_at)
  }

  Note: '§4.2 — кожна зміна ціни лягає ОКРЕМИМ записом із часом і автором; записи не перетираються, а додаються. Чинною є остання за set_at. UNIQUE тут НЕМАЄ навмисно: саме він у колишній shift_grade_prices забороняв історію. reason — «конкуренти підняли» (§4.2). Ключ — трійка (день, точка, сорт) з §2.8, а не (зміна, сорт): керівник ставить ціни о 07:10, приймальник відкриває зміну о 07:30 (§1), тому NOT NULL shift_id був неможливий. §4.1 — ключ ціни це СОРТ, ключ звітності — товар. §4.5 — сорт без ціни дня на прийомці не показується взагалі, тому ВІДСУТНІСТЬ рядка і є вимкненням: поля is_enabled немає, довговічне вимкнення тримає product_grades.is_active. operator_price_delta теж немає: §2.8 кладе надбавку НА РЯДОК (intake_items.bonus), а ціна дня в прийомці під замком — тримати дельту ще й тут означало б ту саму надбавку двічі, дослівно той аргумент, яким відкинуто сорт «ОПТ» у Note product_grades. ЦІНА РІШЕННЯ: intakes більше не має спільної зміни з ціною, тому «ціна тієї точки того дня» тримає застосунок, а не зовнішній ключ. Прийомка бере ціну ЗНІМКОМ у intake_items.price, тому §4.6 (раніші квитанції не перераховуються) тримається сам.'
}

/* цільові значення */

Table cash_floats {
  id uuid [pk]

  collection_point_id uuid [not null, ref: > collection_points.id]

  amount numeric(12,2) [not null]

  effective_from date [not null]

  set_by_user_id uuid [not null, ref: > users.id]
  set_at timestamp [not null]
  reason text

  created_at timestamp [not null]

  indexes {
    (collection_point_id, effective_from) [unique]
  }

  Note: '§7.1 — цільове значення каси задає КЕРІВНИК, і в різних точок воно різне (Шипинки 500 000 ₴). Не вистачає до нього — це БОРГ МЕРЕЖІ ПЕРЕД ТОЧКОЮ, а не мінус у касі. Форма дзеркальна до crate_allotments навмисно: клієнтка сказала «технологія з грошима така сама, як з ящиками». reason порожній дозволений лише для ПЕРШОГО значення точки — попереднього рівня не існувало (§6.1); при будь-якій зміні він обовʼязковий, і це інваріант застосунку, не схеми. §7.10 — точки без цільового значення каси в таблицю боргу мережі не потрапляють узагалі, тому ВІДСУТНІСТЬ рядка тут значуща: рядка з нулем там не буває.'
}

Table crate_allotments {
  id uuid [pk]

  collection_point_id uuid [not null, ref: > collection_points.id]

  units int [not null]

  effective_from date [not null]

  set_by_user_id uuid [not null, ref: > users.id]
  set_at timestamp [not null]
  reason text

  created_at timestamp [not null]

  indexes {
    (collection_point_id, effective_from) [unique]
  }

  Note: '§6.1 — цільове значення ящиків це ІСТОРІЯ, а не число: 15.07.2026 600 → 800, керівник, причина «розширили точку». Зміна НЕ перераховує наявні залишки — звірка за 14 липня лишається такою, якою була. Змінює лише керівник; у приймальника цієї кнопки не існує — не «є, але сіра» (§10.2). Цільове значення, менше за те, що вже в людей і в дорозі, дозволене З ПОПЕРЕДЖЕННЯМ, а не забороною. Правка 14 — невстановлене цільове значення НЕ блокує видачу ящиків, лише попереджає. ЗАПИТАННЯ 12 не закрите: чи наділ розбитий за типами тари. Схема припускає, що НІ (§12.3 дефолт: ягоду не пересипають); якщо так — тут потрібне розбиття, а тотожність 800 = 341 + 195 + 264 перестає бути тотожністю.'
}

Table cash_counts {
  id uuid [pk]

  shift_id uuid [not null, ref: > shifts.id]

  book cash_book       [not null]
  kind cash_count_kind [not null]

  counted_amount  numeric(12,2) [not null]
  expected_amount numeric(12,2) [not null]

  counted_by_user_id uuid [not null, ref: > users.id]
  counted_at timestamp [not null]

  note text

  created_at timestamp [not null]

  indexes {
    (shift_id, book, kind) [unique]
    (shift_id, counted_at)
  }

  Note: '''
**КАСА ТОЧКИ — як вона рахується.** Читати перед першим запитом про гроші точки.

Точки в цій таблиці немає — вона у `shifts`, і два примірники одного факту в цьому проєкті
заборонені за побудовою. `expected_amount` — **знімок** очікуваного на мить перерахунку: без
нього пізніша подія тихо переписала б учорашню розбіжність. Розбіжність = `counted − expected`
і НЕ зберігається; поля вводу для неї немає в жодної ролі (§7.7). Порогів «допустимої»
розбіжності немає взагалі.

`counted_by_user_id` — той, **хто натиснув**, а не той, хто відкривав зміну: §10.6 — «якщо касу
перерахує Марія, у документі перерахунку стоїть Марія, навіть якщо зміну відкривала Оксана».
Перерахунок нічого не виправляє і нічого не перетирає (§7.6) — робити його можна скільки
завгодно разів, звідси `midday` поза унікальним індексом. Сам індекс частковий:
`UNIQUE (shift_id, book, kind) WHERE kind <> 'midday'` — DBML цього не виражає, у SQL дописують
руками.

### ДВІ КНИГИ, ЯКІ НЕ ПОЗИЧАЮТЬ ОДНА В ОДНОЇ

Термінологія правок: каса на ягоду — просто **каса**, усе про ящики — **завдатки**. Правка 1
знімає формулювання §1 «лежать в одній шухляді»: фізично шухляда одна, книг **дві**, і
`cash_book` робить це видимим у кожному запиті — суму без `GROUP BY cash_book` непомітно не
напишеш.

**Книга ягоди** на точці, від `cash_book_from`:

```sql
+ Σ transfers, у яких accepted_date <= D:
      status = 'accepted'                            -> cash
      status = 'disputed' AND resolved_at IS NOT NULL -> resolved_cash
- Σ payouts.amount, де payouts -> shifts дає цю точку і shifts.business_date <= D
      -- УКЛЮЧНО ЗІ СТОРНОВАНИМИ
+ Σ expected_cash_returns.amount, у яких settled_at <= D
```

**Сторновані виплати з формули каси НЕ відсіюються, і це протилежно до формули боргу.** Борг
(Note `payout_allocations`) вимагає відсіяти `voided_at IS NOT NULL`, бо гроші «не видали».
Каса вимагає протилежного: гроші **фізично вийшли з шухляди** і повертаються лише внесенням,
тобто рядком `expected_cash_returns.settled_at`. Один і той самий `voided_at` у двох запитах
читається по-різному — інакше сторно стає способом красти (§9.3).

**Книга ящиків**, від першої видачі, без нижньої межі по датах (§7.5):

```sql
+ Σ crate_issuances.deposit_taken   (voided_at IS NULL)
- Σ crate_returns.deposit_refund    (voided_at IS NULL)
      -- обидві дають точку через shifts, як і виплати
```

**Відкрите, і не полагоджене:** для ящиків сторно трактується протилежно до виплати —
відсторнована видача перестає давати гроші в касу, хоч завдаток фізично в шухляді, і жодного
очікуваного повернення під це немає. Правила такого випадку не описують: §9.3 знає очікуване
повернення лише для виплати, а §9.4 дозволяє сторнувати ящиковий документ тільки керівнику й
забороняє сторно видачі, на яку вже лягло повернення. Асиметрія свідома й названа.

**Що касу НЕ рухає:** витрати дня (§7.2 — «каса тільки ягодами, ті всі різні розтрати я передаю
окремо»), ручна видача «не за ягоду» та інкасація — їх у системі немає взагалі (§7.3, список
джерел закритий). Таблиці рухів каси теж немає: правка 9 — «система рахує загальну суму в касі
за допомогою денних транзакцій». Збережений залишок заборонений тією ж причиною, що й
`remaining` у `intakes` (§3.2).
'''
}

/* перекази база → точка */

Table transfers {
  id uuid [pk]
  code varchar [not null, unique]

  collection_point_id uuid [not null, ref: > collection_points.id]

  cash   numeric(12,2) [not null]
  crates int [not null]

  carrier varchar [not null]

  sent_by_user_id uuid [not null, ref: > users.id]
  sent_at timestamp [not null]

  status transfer_status [not null, default: 'sent']

  accepted_by_user_id uuid [ref: > users.id]
  accepted_date date
  accepted_at   timestamp

  reported_cash   numeric(12,2)
  reported_crates int
  dispute_note    text

  resolved_cash   numeric(12,2)
  resolved_crates int
  resolved_by_user_id uuid [ref: > users.id]
  resolved_at timestamp

  correction_of_transfer_id uuid [ref: > transfers.id]

  voided_at timestamp
  voided_by_user_id uuid [ref: > users.id]
  void_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (collection_point_id, accepted_date)
    (status)
  }

  Note: '§7.9 — переказ несе гроші й порожні ящики однією поїздкою. carrier це ТЕКСТ, не обліковий запис: «Іван, Ducato» підписує в зошиті перевізник, і без перевізника документ не проводиться. У стані sent не рухається НІЧОГО: ні каса точки, ні цільове значення ящиків. accepted_date — ДЕНЬ ПРИЙНЯТТЯ, і саме ним зараховуються гроші та ящики: машина виїхала ввечері, точка порахувала вранці, і гроші не мають лежати в касі за день, коли їх фізично не було. Натиснути «Прийняв» може ТІЛЬКИ точка (§10.3) — керівник не може зробити це за неї. reported_* і dispute_note — те, що точка нарахувала при «Не сходиться»: це ІНФОРМАЦІЯ для керівника, у формули не входить ніколи. resolved_* — відповідь на ЗАПИТАННЯ 4 і несуче поле: §7.9 крок 4б каже, що після підтвердження у формулу потрапляє число, яке вказує КЕРІВНИК, закриваючи спір; без цієї пари єдиним місцем для того числа стало б редагування cash, тобто тихе переписування проведеного документа. correction_of_transfer_id — виправлення це НОВИЙ документ. ІНВАРІАНТ ЗАСТОСУНКУ, якого схема не перевіряє: accepted_* заповнені рівно при status = accepted, reported_* і dispute_note — лише при disputed, resolved_* — лише коли спір закрито; CHECK під це не написаний навмисно, бо стан документа міняється в часі й проміжні комбінації існують. §9.4 — сторнує переказ тільки керівник; точка сторнувати не може. Борг мережі перед точкою (§7.10) НЕ зберігається: це cash_floats.amount мінус каса точки.'
}

Table expected_cash_returns {
  id uuid [pk]

  payout_id uuid [not null, unique, ref: > payouts.id]

  amount numeric(12,2) [not null]

  settled_at timestamp
  settled_by_user_id uuid [ref: > users.id]

  note text

  created_at timestamp [not null]

  Note: '§9.3 — «сторновано виплату 8 000,00 ₴ → каса НЕ виросла на 8 000 → створюється ОЧІКУВАНЕ ПОВЕРНЕННЯ під фізичне внесення грошей. Інакше сторно стає способом красти». Поки settled_at порожній, каса точки лишається зменшеною на суму виплати; внесення грошей — це заповнення settled_at, і саме воно повертає суму в книгу ягоди. UNIQUE на payout_id: одне очікуване повернення на виплату. Як це входить у формулу — розгорнута Note таблиці cash_counts.'
}

/* ------------------------- прийомка ягоди ------------------------- */

Table intakes {
  id uuid [pk]

  code varchar [not null, unique]

  shift_id uuid [not null, ref: > shifts.id]
  supplier_id uuid [not null, ref: > suppliers.id]

  amount numeric(12,2) [not null]

  received_by_user_id uuid [not null, ref: > users.id]

  voided_at timestamp
  voided_by_user_id uuid [ref: > users.id]
  void_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (supplier_id, created_at)
    (shift_id)
  }

  Note: '§2.3 — один візит із кількома сортами це ОДИН документ із кількома рядками (стеля 5), а не кілька прийомок; amount = Σ intake_items.amount, те саме число, що надруковане на папері. Точка й бізнес-дата беруться зі зміни, автор транзакції — окремо (правка 16): хто відкрив зміну і хто провів квитанцію, це різні люди. Виплачене й залишок ТУТ НЕ ЗБЕРІГАЮТЬСЯ (§3.2): залишок = amount − Σ payout_allocations.amount. §9.3 — сторно повне, з обовʼязковою причиною, документ лишається в журналі назавжди. Як рахується залишок — розгорнута Note таблиці payout_allocations.'
}

Table intake_items {
  id uuid [pk]

  intake_id uuid [not null, ref: > intakes.id]

  item_order int [not null]

  product_grade_id uuid [not null, ref: > product_grades.id]

  gross_kg numeric(10,2) [not null]
  pallet_kg numeric(10,2) [not null, default: 0]
  tare_weight_kg numeric(10,2) [not null]
  net_kg numeric(10,2) [not null]

  price numeric(10,2) [not null]
  bonus numeric(10,2) [not null, default: 0]
  amount numeric(12,2) [not null]

  indexes {
    (intake_id, item_order) [unique]
  }

  Note: '§2.4 — піддон віднімається ПЕРШИМ, тара другою: net = (gross − pallet) − tare_weight. Поля net людина не вводить ніколи. §2.8 — price це ЗНІМОК ціни дня (base_price + operator_price_delta на мить прийомки), bonus живе НА РЯДКУ, а не на людині: одна людина може здати два сорти з різними надбавками, і від’ємний bonus це мʼята чи цвіла ягода. §2.9 — межа мережі ±30 ₴/кг обрізає bonus, але самої межі в цій схемі поки НЕМАЄ де зберігати.'
}

Table intake_item_tare_types {
  item_id uuid [not null, ref: > intake_items.id]
  tare_type_id uuid [not null, ref: > tare_types.id]

  units int [not null]

  indexes {
    (item_id, tare_type_id) [pk]
  }

  Note: '§2.6 — ящики В КВИТАНЦІЇ (вага, що знімається) і ящики НА РУКАХ (майно, crate_issuances) ніде не складаються в одне.'
}

/* --------------------------- виплати --------------------------- */

Table payouts {
  id uuid [pk]

  code varchar [not null, unique]

  shift_id uuid [not null, ref: > shifts.id]
  supplier_id uuid [not null, ref: > suppliers.id]

  amount numeric(12,2) [not null]

  paid_by_user_id uuid [not null, ref: > users.id]

  voided_at timestamp
  voided_by_user_id uuid [ref: > users.id]
  void_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (supplier_id, created_at)
  }

  Note: '§3.5 — видати більше за «Разом» неможливо, сума обрізається; від’ємного залишку виплата не створює. §3.6 — стеля подвійна: min(Разом, каса за ягоду). §3.7 — дозволена будь-яка сума від 0 до «Разом». §9.3 — сторно виплати НЕ повертає готівку в касу само: під фізичне внесення створюється expected_cash_returns, і доки settled_at порожній, каса лишається зменшеною. Як рахується залишок — розгорнута Note таблиці payout_allocations.'
}

Table payout_allocations {
  payout_id uuid [not null, ref: > payouts.id]
  intake_id uuid [not null, ref: > intakes.id]

  amount numeric(12,2) [not null]

  indexes {
    (payout_id, intake_id) [pk]
    (intake_id)
  }

  Note: '''
**БОРГ ПОСТАЧАЛЬНИКА — як він рахується.** Читати перед першим запитом до `intakes`,
`payouts` і цієї таблиці.

### Що є що

- **`intakes`** — квитанція: приймальник узяв ягоду і тим САМИМ створив борг перед людиною.
  `intake.amount` = Σ `intake_items.amount`, те саме число, що надруковане на папері.
- **`payouts`** — видача готівки. Сама по собі вона нічого не «закриває»: закривають рядки розподілу.
- **`payout_allocations`** — звʼязка «яка виплата скільки поклала на яку квитанцію».
  Багато-до-багатьох в обидва боки: одна виплата гасить кілька квитанцій (§3.3),
  і одна квитанція може закриватися кількома виплатами в різні дні.
  Часткова оплата тому не потребує НІЧОГО окремого — це просто розподіл, менший за `amount`.

### Залишку в базі немає, його завжди рахують

Ані в `intakes`, ані в `suppliers` немає колонок `paid` / `debt` / `balance`, і додавати їх
не можна: §3.2 каже, що поля «Залишок» не існує як поля вводу для ЖОДНОЇ ролі, включно з
керівником. Збережений кеш — рівно те місце, де в робочій книзі клієнта рвався ланцюжок:
124 розриви з 1 473.

**Залишок однієї квитанції** = `intake.amount − Σ payout_allocations.amount`, але тільки за
НЕсторнованими виплатами. У `payout_allocations` НЕМАЄ власного поля сторно — рядок належить
виплаті. Тому кожен запит про гроші мусить приєднати `payouts` і відсіяти `voided_at IS NOT NULL`.
Забути це — значить далі гасити борг грошима, яких уже не видали.

```sql
SELECT i.id,
       i.amount - COALESCE((
           SELECT SUM(pa.amount)
             FROM payout_allocations pa
             JOIN payouts p ON p.id = pa.payout_id
            WHERE pa.intake_id = i.id
              AND p.voided_at IS NULL
       ), 0) AS remaining
  FROM intakes i
 WHERE i.voided_at IS NULL;
```

**Борг перед людиною** = сума `remaining` по всіх її НЕсторнованих квитанціях.
`suppliers` — запис НА ТОЧЦІ (§3.9), тому `supplier_id` уже означає точку: окремо
фільтрувати точку не треба й не можна.

### Статус квитанції — похідна, а не колонка

- `remaining = 0` → **Paid**
- `0 < remaining < amount` → **Partially Paid**
- `remaining = amount` → **Open**

Зберігати статус полем не можна: він міняється від чужої події (нова виплата, сторно
виплати) і збережений одразу почне розходитися з розподілом.

### FIFO

Розподіл створює ЗАСТОСУНОК, не база: жодного тригера чи обмеження тут немає. §3.3 —
гаситься найстаріший борг першим. Порядок беруть за БІЗНЕС-ДАТОЮ зміни, а не за `created_at`:
`ORDER BY sh.business_date, i.created_at, i.id`. Сьогодні ці ключі збігаються, бо §4.7
забороняє квитанцію заднім числом, — але це ПРАВИЛО, а не обмеження схеми.

### Сторно

- **Сторно виплати** → її рядки розподілу перестають враховуватися, і борги самі
  повертаються до попередніх сум, з ПОЧАТКОВИМИ датами (§9.3). Рядки при цьому НЕ видаляють.
  Готівка в касу сама не повертається (§9.3) — під це потрібне очікуване повернення,
  і сутності під нього тут ЩЕ НЕМАЄ.
- **Сторно квитанції** → вона випадає з боргу цілком.

### Історія нерухома

`intake.amount` після проведення не міняється НІКОЛИ — ані при виплаті, ані при сторно, ані
при зміні цін чи довідників (§2.7). На баланс впливають рівно дві речі: поява або зникнення
рядків розподілу і поля `void_*`. `updated_at` на документі рухається лише через сторно,
не через гроші.

### Приклад

```
Квитанції:  #1 = 2 000,00   #2 = 3 000,00   #3 = 500,00     борг разом 5 500,00
Виплата:    4 000,00
Розподіл:   2 000,00 -> #1   (закрито)
            2 000,00 -> #2   (2 000 з 3 000)
            #3 не чіпали — гроші скінчилися
Залишки:    #1 =     0,00   Paid
            #2 = 1 000,00   Partially Paid
            #3 =   500,00   Open            борг разом 1 500,00
```

Сторнували цю виплату → обидва рядки розподілу перестають рахуватися, залишки САМІ стають
2 000 / 3 000 / 500, борг знову 5 500,00. Руками не перераховують нічого, бо ніде й не зберігали.

### Інваріанти, які тримає застосунок (у схемі їх не перевіряє ніщо)

1. Σ рядків розподілу однієї виплати = `payout.amount`. Виплата не може перевищити «Разом»
   (§3.5), а «Разом» — це сьогоднішня квитанція плюс відкриті залишки, тому кожна видана
   копійка має куди лягти.
2. Для кожної квитанції Σ розподілів ≤ `intake.amount`: відʼємного залишку не буває (§3.5,
   і саме звідси 257 відʼємних рядків у книзі клієнта).

### Відкрите, знайдене при огляді 02.09.2026 — не полагоджено, названо

- Схема ДОЗВОЛЯЄ сторнувати квитанцію, на яку вже лягли розподіли. Тоді гроші зникають із
  боргу, хоч їх реально видали. Для ящиків §9.3 таке прямо забороняє («видачу, на яку вже
  лягло повернення, сторнувати не можна»); для квитанцій аналогічного правила не записано.
- Обидва інваріанти вище — домовленість, а не `CHECK`. Найдешевша перевірка: нічний запит,
  що шукає `payout.amount <> Σ розподілів` і `remaining < 0`.
'''
}

/* ---------------------------- ящики ---------------------------- */

Table crate_issuances {
  id uuid [pk]

  shift_id uuid [not null, ref: > shifts.id]
  supplier_id uuid [not null, ref: > suppliers.id]

  units int [not null]

  mode crate_issuance_mode [not null]

  deposit_per_unit numeric(12,2) [not null, default: 0]
  deposit_taken numeric(12,2) [not null, default: 0]

  receipt_no varchar

  issued_by_user_id uuid [not null, ref: > users.id]

  voided_at timestamp
  voided_by_user_id uuid [ref: > users.id]
  void_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (supplier_id, created_at)
  }

  Note: '§6.2 — спосіб система підставляє сама (до 50 завдаток, від 51 розписка), приймальник може перемкнути: екран перепитає, але не заблокує. §6.3 — завдаток = units × deposit_per_unit лягає в КАСУ ЗА ЯЩИКИ. §6.4 — за розписку грошей немає взагалі (deposit_* = 0, на екрані «—», не «0,00»), номер розписки вписується руками; ЗАПИТАННЯ 2 (генерувати чи вводити) не закрите. §2.7 — deposit_per_unit це ЗНІМОК: зміна ціни ящика зі 120 на 130 не переписує липневу видачу. §9.4 — ящиковий документ сторнує ТІЛЬКИ керівник.'
}

Table crate_returns {
  id uuid [pk]

  shift_id uuid [not null, ref: > shifts.id]
  supplier_id uuid [not null, ref: > suppliers.id]

  units int [not null]

  deposit_refund numeric(12,2) [not null, default: 0]

  accepted_by_user_id uuid [not null, ref: > users.id]

  voided_at timestamp
  voided_by_user_id uuid [ref: > users.id]
  void_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (supplier_id, created_at)
  }

  Note: '§6.5 — повернення часткове дозволене, повернути більше, ніж узято, не можна. Правка 15: якщо привезли 25 при виданих 20 — у систему йдуть тільки 20, решта 5 це обмін порожніми на ящики постачальника, і в обліку його немає. §6.7 — гроші виходять із каси за ящики; порожня каса за ягоду цьому не заважає, а порожня каса за ящики БЛОКУЄ повернення.'
}

Table crate_return_allocations {
  return_id uuid [not null, ref: > crate_returns.id]
  issuance_id uuid [not null, ref: > crate_issuances.id]

  units int [not null]
  per_unit numeric(12,2) [not null]
  amount numeric(12,2) [not null]

  indexes {
    (return_id, issuance_id) [pk]
    (issuance_id)
  }

  Note: '§6.5 — гаситься найстаріша видача першою, і per_unit береться З ТІЄЇ видачі, а не з довідника: людина, яка брала по 120 і по 130, отримує назад саме те, що платила. Приймальник при цьому нічого не питає і не обирає. §6.6 — розписка й завдаток не змішуються навіть у поверненні. §9.3 — видачу, на яку вже лягло повернення, сторнувати не можна, поки не сторновано повернення.'
}
