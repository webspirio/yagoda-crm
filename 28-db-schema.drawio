        <mxCell id="n_title" value="Ягода CRM — схема бази даних" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="900" height="34" as="geometry"/></mxCell>
        <mxCell id="n_sub" value="Чернетка, побудована з DBML. Сім таблиць, вісім зовнішніх ключів." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="900" height="20" as="geometry"/></mxCell>
        <mxCell id="n_band1" value="МЕРЕЖА · ПУНКТИ, ЛЮДИ, ЗМІНИ" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#8b93a1;letterSpacing=1;" vertex="1" parent="1"><mxGeometry x="40" y="108" width="700" height="22" as="geometry"/></mxCell>
        <mxCell id="n_band2" value="НОМЕНКЛАТУРА · ТОВАРИ, СОРТИ, ЦІНИ ЗМІНИ" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#8b93a1;letterSpacing=1;" vertex="1" parent="1"><mxGeometry x="40" y="1022" width="700" height="22" as="geometry"/></mxCell>
        <mxCell id="n_band1l" style="endArrow=none;html=1;strokeColor=#dfe3e8;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="132" as="sourcePoint"/><mxPoint x="1250" y="132" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_band2l" style="endArrow=none;html=1;strokeColor=#dfe3e8;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="1046" as="sourcePoint"/><mxPoint x="1250" y="1046" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_legend" value="&lt;b&gt;Як читати&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; — первинний ключ · &lt;i&gt;FK&lt;/i&gt; — зовнішній ключ&lt;br&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;?&lt;/font&gt; після назви — поле може бути порожнім (NULL)&lt;br&gt;· UQ — унікальне · = x — значення за замовчуванням&lt;br&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;◇&lt;/font&gt; — унікальний складений індекс&lt;br&gt;&lt;br&gt;Лінія: «лапка» = багато, «‖» = рівно один.&lt;br&gt;Читається від «багато» до «один»:&lt;br&gt;багато змін — в одному пункті.&lt;br&gt;&lt;br&gt;Колір заголовка = група таблиць." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#374151;fillColor=#fbfcfd;strokeColor=#dfe3e8;" vertex="1" parent="1"><mxGeometry x="900" y="148" width="350" height="236" as="geometry"/></mxCell>
        <mxCell id="n_enum" value="&lt;b&gt;Enum user_role&lt;/b&gt;&lt;br&gt;• network_admin — адміністратор мережі&lt;br&gt;• point_manager — керівник пункту" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#5b4a12;fillColor=#fdf8e3;strokeColor=#d9c56a;dashed=1;" vertex="1" parent="1"><mxGeometry x="470" y="400" width="350" height="92" as="geometry"/></mxCell>
        <mxCell id="n_grade" value="&lt;b&gt;product_grades — сорт товару&lt;/b&gt;&lt;br&gt;Приклади: «1 сорт», «2 сорт», «Екстра», «ОПТ».&lt;br&gt;Ціна ставиться на СОРТ, не на товар." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#5b4a12;fillColor=#fdf8e3;strokeColor=#d9c56a;dashed=1;" vertex="1" parent="1"><mxGeometry x="470" y="1320" width="350" height="92" as="geometry"/></mxCell>
        <mxCell id="n_price" value="&lt;b&gt;Ціна дня живе на ЗМІНІ&lt;/b&gt;&lt;br&gt;ціна = base_price + operator_price_delta&lt;br&gt;Новий день — нова зміна — новий рядок налаштувань." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#5b4a12;fillColor=#fdf8e3;strokeColor=#d9c56a;dashed=1;" vertex="1" parent="1"><mxGeometry x="900" y="812" width="350" height="92" as="geometry"/></mxCell>
        <mxCell id="n_enum_e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;dashed=1;html=1;strokeColor=#d9c56a;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="n_enum" target="r_18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="452" y="446"/><mxPoint x="452" y="289"/></Array></mxGeometry></mxCell>
        <mxCell id="n_grade_e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;dashed=1;html=1;strokeColor=#d9c56a;strokeWidth=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="n_grade" target="r_171"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="452" y="1366"/><mxPoint x="452" y="1157"/></Array></mxGeometry></mxCell>
        <mxCell id="n_price_e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;dashed=1;html=1;strokeColor=#d9c56a;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="n_price" target="r_207"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1275" y="858"/><mxPoint x="1275" y="1183"/></Array></mxGeometry></mxCell>
