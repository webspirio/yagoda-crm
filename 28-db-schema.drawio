                <mxCell id="e_1010" value="закрив спір" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#8b93a1;strokeWidth=1.5;fontSize=10;fontColor=#4b5563;labelBackgroundColor=#ffffff;" parent="1" source="r_2159" target="r_103" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="3514" y="979"/>
                            <mxPoint x="3514" y="485"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_1011" value="сторнував" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#8b93a1;strokeWidth=1.5;fontSize=10;fontColor=#4b5563;labelBackgroundColor=#ffffff;" parent="1" source="r_2175" target="r_103" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="3538" y="1083"/>
                            <mxPoint x="3538" y="485"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_1013" value="виправляє" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#8b93a1;strokeWidth=1.5;fontSize=10;fontColor=#4b5563;labelBackgroundColor=#ffffff;" parent="1" source="r_2167" target="r_2095" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="3442" y="1031"/>
                            <mxPoint x="3442" y="563"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_2900" value="вніс" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#8b93a1;strokeWidth=1.5;fontSize=10;fontColor=#4b5563;labelBackgroundColor=#ffffff;" parent="1" source="r_2075" target="r_103" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="2150" y="849"/>
                            <mxPoint x="2150" y="485"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="n_title" value="Ягода CRM — схема бази даних" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" parent="1" vertex="1">
                    <mxGeometry x="100" y="34" width="1200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="n_sub" value="Чернетка з 28-db-schema.dbml. 19 таблиць, 43 зовнішні ключі, 8 enum-ів, 178 полів. Правила — 26-rules-by-example.md." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#6b7280;" parent="1" vertex="1">
                    <mxGeometry x="100" y="80" width="1200" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="n_legend" value="&lt;b&gt;Як читати&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; — первинний ключ · &lt;i&gt;FK&lt;/i&gt; — зовнішній ключ&lt;br&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;?&lt;/font&gt; після назви — поле може бути порожнім (NULL)&lt;br&gt;· UQ — унікальне · = x — значення за замовчуванням&lt;br&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;◇&lt;/font&gt; — складений ключ або індекс&lt;br&gt;&lt;br&gt;Лінія: «лапка» = багато, «‖» = рівно один.&lt;br&gt;Читається від «лапки»: багато квитанцій —&lt;br&gt;в одного постачальника.&lt;br&gt;&lt;br&gt;&lt;b&gt;Колір заголовка = група&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4472c4&quot;&gt;■&lt;/font&gt; мережа: пункти, люди, зміни&lt;br&gt;&lt;font color=&quot;#c07b17&quot;&gt;■&lt;/font&gt; постачальник і довідник сіл&lt;br&gt;&lt;font color=&quot;#7a5b93&quot;&gt;■&lt;/font&gt; номенклатура і тара&lt;br&gt;&lt;font color=&quot;#4f9153&quot;&gt;■&lt;/font&gt; ціни дня&lt;br&gt;&lt;font color=&quot;#2a7f8f&quot;&gt;■&lt;/font&gt; прийомка і виплати&lt;br&gt;&lt;font color=&quot;#a4573f&quot;&gt;■&lt;/font&gt; ящики&lt;br&gt;&lt;font color=&quot;#9c4a6f&quot;&gt;■&lt;/font&gt; каса і перекази&lt;br&gt;&lt;br&gt;&lt;b&gt;Колір заголовка — маркер групи&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;Пунктирних рамок немає: колір заголовка&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;каже про групу те саме. Колонки: посередині&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;— мережа, люди й постачальник, на них&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;посилається все; ліворуч номенклатура і&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;прийомка, праворуч ящики й каса.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#374151;fillColor=#fbfcfd;strokeColor=#dfe3e8;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1928" width="330" height="448" as="geometry"/>
                </mxCell>
                <mxCell id="n_fifo" value="&lt;b&gt;Одна таблиця розподілу — і вона про ЯЩИКИ&lt;/b&gt;&lt;br&gt;crate_return_allocations — §6.5: повернення гасить&lt;br&gt;найстарішу видачу за ЇЇ ціною ящика, не сьогоднішньою.&lt;br&gt;Для ГРОШЕЙ такої таблиці немає з 04.09.2026: борг це&lt;br&gt;різниця двох історій, і гасити поштучно нема чого." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#5b4a12;fillColor=#fdf8e3;strokeColor=#d9c56a;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1000" width="330" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="n_snapshot" value="&lt;b&gt;Знімок, а не перерахунок (§2.7)&lt;/b&gt;&lt;br&gt;price, tare_weight_kg, deposit_per_unit копіюються&lt;br&gt;у документ у мить проведення. Керівник міняє довідник —&lt;br&gt;липнева квитанція і липнева видача не рухаються." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#5b4a12;fillColor=#fdf8e3;strokeColor=#d9c56a;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="790" y="1100" width="350" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="n_derived" value="&lt;b&gt;Чого тут немає навмисно&lt;/b&gt;&lt;br&gt;«Залишок» і «Разом» не зберігаються (§3.2), а залишку&lt;br&gt;ОКРЕМОЇ квитанції не існує взагалі: борг — різниця&lt;br&gt;двох історій. Полів під §5.4 і §5.5 (дублікати,&lt;br&gt;обʼєднання) немає — правки 5 і 6 їх зняли; села теж&lt;br&gt;немає — villages прибрано 04.09.2026." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#5b4a12;fillColor=#fdf8e3;strokeColor=#d9c56a;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="790" y="1350" width="350" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="n_cash_title" value="КАСА ТОЧКИ — як вона рахується" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontColor=#9c4a6f;" parent="1" vertex="1">
                    <mxGeometry x="470" y="1886" width="900" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="n_cash_a" value="&lt;b&gt;1 · Дві книги, які не позичають одна в одної&lt;/b&gt;&lt;br&gt;&lt;br&gt;Фізично шухляда одна, книг &lt;b&gt;дві&lt;/b&gt; — і поле&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;cash_book&lt;/font&gt; робить це видимим у кожному запиті:&lt;br&gt;суму без &lt;font face=&quot;Courier New&quot;&gt;GROUP BY cash_book&lt;/font&gt; непомітно&lt;br&gt;не напишеш. Правка 1 знімає формулювання §1&lt;br&gt;«лежать в одній шухляді».&lt;br&gt;&lt;br&gt;Термінологія правок: каса на ягоду — просто&lt;br&gt;&lt;b&gt;каса&lt;/b&gt;, усе про ящики — &lt;b&gt;завдатки&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 · Книга ягоди&lt;/b&gt; на точці. Нижньої межі в схемі немає:&lt;br&gt;день, з якого ведеться касова книга, — параметр застосунку.&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;+ Σ transfers, у яких accepted_date &amp;lt;= D&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; і voided_at IS NULL:&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; status = &#39;accepted&#39; &amp;nbsp; &amp;nbsp;-&amp;gt; cash&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; status = &#39;disputed&#39; AND resolved_at IS NOT NULL&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;-&amp;gt; resolved_cash&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;− Σ payouts.amount, де payouts -&amp;gt; shifts&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; дає цю точку і business_date &amp;lt;= D&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; -- ВКЛЮЧНО ЗІ СТОРНОВАНИМИ&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;+ Σ payouts.amount, у яких&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; return_settled_at &amp;lt;= D&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3 · Сторновані виплати з каси НЕ відсіюються&lt;/b&gt;&lt;br&gt;&lt;br&gt;…і це протилежно до формули боргу. Борг&lt;br&gt;(смуга нижче) вимагає відсіяти &lt;font face=&quot;Courier New&quot;&gt;voided_at IS&lt;br&gt;NOT NULL&lt;/font&gt; — гроші «не видали». Каса вимагає&lt;br&gt;протилежного: гроші &lt;b&gt;фізично вийшли з шухляди&lt;/b&gt;&lt;br&gt;і повертаються лише внесенням, тобто рядком&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;payouts.return_settled_at&lt;/font&gt;.&lt;br&gt;&lt;br&gt;Один і той самий &lt;font face=&quot;Courier New&quot;&gt;voided_at&lt;/font&gt; у двох запитах&lt;br&gt;читається по-різному — інакше сторно стає&lt;br&gt;способом красти (§9.3).&lt;br&gt;&lt;br&gt;&lt;b&gt;4 · Перерахунок нічого не виправляє&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;expected_amount&lt;/font&gt; — &lt;b&gt;знімок&lt;/b&gt; очікуваного на мить&lt;br&gt;перерахунку: без нього пізніша подія тихо&lt;br&gt;переписала б учорашню розбіжність.&lt;br&gt;Розбіжність = &lt;font face=&quot;Courier New&quot;&gt;counted − expected&lt;/font&gt; і &lt;b&gt;не&lt;br&gt;зберігається&lt;/b&gt;; поля вводу для неї немає в&lt;br&gt;жодної ролі (§7.7). Порогів «допустимої»&lt;br&gt;розбіжності немає взагалі.&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;counted_by_user_id&lt;/font&gt; — той, &lt;b&gt;хто натиснув&lt;/b&gt;, а не&lt;br&gt;той, хто відкривав зміну (§10.6).&lt;br&gt;&lt;br&gt;Індекс частковий: &lt;font face=&quot;Courier New&quot;&gt;UNIQUE (shift_id, book,&lt;br&gt;kind) WHERE kind &amp;lt;&amp;gt; midday&lt;/font&gt; — DBML цього не&lt;br&gt;виражає, у SQL дописують руками. Звідси&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;midday&lt;/font&gt; поза унікальним індексом: перерахунок&lt;br&gt;можна робити скільки завгодно разів (§7.6)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=11;fontColor=#1f2328;fillColor=#fbfcfd;strokeColor=#9c4a6f;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="470" y="1928" width="440" height="950" as="geometry"/>
                </mxCell>
                <mxCell id="n_cash_b" value="&lt;b&gt;5 · Книга ящиків&lt;/b&gt; — від першої видачі, без&lt;br&gt;нижньої межі по датах (§7.5):&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;+ Σ crate_issuances.deposit_taken&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;− Σ crate_returns.deposit_refund&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; обидві: voided_at IS NULL, і точку&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp; &amp;nbsp; дають через shifts, як і виплати&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;6 · Асиметрія сторно — відкрите й не&lt;br&gt;полагоджене&lt;/b&gt;&lt;br&gt;&lt;br&gt;Для ящиків сторно трактується &lt;b&gt;протилежно&lt;/b&gt; до&lt;br&gt;виплати: відсторнована видача перестає давати&lt;br&gt;гроші в касу, хоч завдаток фізично в шухляді,&lt;br&gt;і жодного очікуваного повернення під це немає.&lt;br&gt;&lt;br&gt;Правила такого випадку не описують: §9.3 знає&lt;br&gt;очікуване повернення лише для &lt;b&gt;виплати&lt;/b&gt;, а §9.4&lt;br&gt;дозволяє сторнувати ящиковий документ тільки&lt;br&gt;керівникові й забороняє сторно видачі, на яку&lt;br&gt;вже лягло повернення.&lt;br&gt;&lt;br&gt;Асиметрія свідома й &lt;b&gt;названа&lt;/b&gt;, а не полагоджена.&lt;br&gt;&lt;br&gt;&lt;b&gt;7 · Що касу НЕ рухає&lt;/b&gt;&lt;br&gt;&lt;br&gt;· витрати дня — §7.2: «каса тільки ягодами, ті&lt;br&gt;&amp;nbsp; всі різні розтрати я передаю окремо»;&lt;br&gt;· ручна видача «не за ягоду» та інкасація — їх&lt;br&gt;&amp;nbsp; у системі немає взагалі (§7.3, список джерел&lt;br&gt;&amp;nbsp; закритий).&lt;br&gt;&lt;br&gt;Таблиці рухів каси теж немає: правка 9 —&lt;br&gt;«система рахує загальну суму в касі за&lt;br&gt;допомогою денних транзакцій». Збережений&lt;br&gt;залишок заборонений тією самою причиною, що й&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;remaining&lt;/font&gt; у &lt;font face=&quot;Courier New&quot;&gt;intakes&lt;/font&gt; (§3.2).&lt;br&gt;&lt;br&gt;&lt;b&gt;8 · Точки в cash_counts немає&lt;/b&gt;&lt;br&gt;&lt;br&gt;Вона у &lt;font face=&quot;Courier New&quot;&gt;shifts&lt;/font&gt;, і два примірники одного факту&lt;br&gt;в цьому проєкті заборонені за побудовою.&lt;br&gt;&lt;br&gt;&lt;b&gt;9 · Борг мережі перед точкою не зберігається&lt;/b&gt;&lt;br&gt;&lt;br&gt;Це &lt;font face=&quot;Courier New&quot;&gt;collection_points.target_cash&lt;/font&gt; мінус каса&lt;br&gt;точки (§7.10). Точки без цільового значення&lt;br&gt;каси в таблицю боргу мережі не потрапляють&lt;br&gt;узагалі — тому &lt;b&gt;порожній&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;target_cash&lt;/font&gt; значущий:&lt;br&gt;нуля там не буває.&lt;br&gt;&lt;br&gt;&lt;b&gt;10 · Ця записка живе тричі й навмисно&lt;/b&gt;&lt;br&gt;&lt;br&gt;Тут, розгорнутою &lt;font face=&quot;Courier New&quot;&gt;Note&lt;/font&gt; таблиці &lt;font face=&quot;Courier New&quot;&gt;cash_counts&lt;/font&gt; і&lt;br&gt;третьою копією в 28-tables.md. Правити треба &lt;b&gt;всі три&lt;/b&gt;:&lt;br&gt;розійтися вони можуть, і ніщо цього не ловить." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=11;fontColor=#1f2328;fillColor=#fbfcfd;strokeColor=#9c4a6f;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="950" y="1928" width="440" height="950" as="geometry"/>
                </mxCell>
                <mxCell id="n_debt_title" value="БОРГ ПОСТАЧАЛЬНИКА — як він рахується" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontColor=#2a7f8f;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="1886" width="900" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="n_debt_sub" value="Той самий текст — розгорнутою Note таблиці suppliers у 28-db-schema.dbml." style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#6b7280;" parent="1" vertex="1">
                    <mxGeometry x="2350" y="1888" width="840" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="n_debt_a" value="&lt;b&gt;1 · Що є що&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;intakes&lt;/b&gt; — квитанція: приймальник узяв ягоду і тим&lt;br&gt;самим створив борг. amount = Σ intake_items.amount —&lt;br&gt;те саме число, що надруковане на папері.&lt;br&gt;&lt;b&gt;payouts&lt;/b&gt; — видача готівки. Вона теж нічого не&lt;br&gt;«закриває» — закривати нема чого.&lt;br&gt;&lt;b&gt;payout_allocations БІЛЬШЕ НЕМАЄ&lt;/b&gt;: таблицю прибрано&lt;br&gt;04.09.2026 рішенням власника — «не рахуємо, що який&lt;br&gt;борг закриває».&lt;br&gt;&lt;br&gt;&lt;b&gt;2 · Борг = різниця двох історій&lt;/b&gt;&lt;br&gt;&lt;br&gt;Борг НЕ властивість документа, а властивість ЛЮДИНИ&lt;br&gt;НА ТОЧЦІ — тому записка живе при suppliers.&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;SELECT&amp;nbsp;s.id,&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;COALESCE((SELECT&amp;nbsp;SUM(i.amount)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;FROM&amp;nbsp;intakes&amp;nbsp;i&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;WHERE&amp;nbsp;i.supplier_id&amp;nbsp;=&amp;nbsp;s.id&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;AND&amp;nbsp;i.voided_at&amp;nbsp;IS&amp;nbsp;NULL),&amp;nbsp;0)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;-&amp;nbsp;COALESCE((SELECT&amp;nbsp;SUM(p.amount)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;FROM&amp;nbsp;payouts&amp;nbsp;p&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;WHERE&amp;nbsp;p.supplier_id&amp;nbsp;=&amp;nbsp;s.id&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;AND&amp;nbsp;p.voided_at&amp;nbsp;IS&amp;nbsp;NULL),&amp;nbsp;0)&amp;nbsp;AS&amp;nbsp;debt&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;FROM&amp;nbsp;suppliers&amp;nbsp;s;&lt;/font&gt;&lt;br&gt;supplier_id уже означає точку (§3.9): окремо&lt;br&gt;фільтрувати точку не треба й не можна. voided_at IS&lt;br&gt;NULL стоїть на ОБОХ історіях, і забути його на&lt;br&gt;будь-якій означає або гасити борг грошима, яких не&lt;br&gt;видали, або тримати борг за ягоду, якої не брали.&lt;br&gt;&lt;br&gt;Колонок paid / debt / balance немає ніде, і додавати&lt;br&gt;їх не можна (§3.2). Збережений кеш — рівно те місце,&lt;br&gt;де в книзі клієнта рвався ланцюжок: &lt;b&gt;124 розриви&lt;br&gt;з 1 473&lt;/b&gt;." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=11;fontColor=#1f2328;fillColor=#fbfcfd;strokeColor=#2a7f8f;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="1928" width="560" height="740" as="geometry"/>
                </mxCell>
                <mxCell id="n_debt_b" value="&lt;b&gt;3 · Чого більше немає — рішення, не пропуск&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Розподілу і FIFO (§3.3): жодна виплата не памʼятає,&lt;br&gt;  яку саме дату вона закрила.&lt;br&gt;• Недоплати, що осідає на сьогоднішній квитанції&lt;br&gt;  (§3.4): осідати нема на чому.&lt;br&gt;• Порядкового списку відкритих залишків (§3.10) і&lt;br&gt;  статусів Paid / Partially Paid / Open. Картка —&lt;br&gt;  ДВА ОКРЕМІ СПИСКИ і одне число під ними.&lt;br&gt;• Розкладки «видано з каси» на «за сьогоднішню ягоду»&lt;br&gt;  і «за ягоду інших днів» (§7.3, Інваріант дня,&lt;br&gt;  [БР-18, ЗВ-06, КС-13]). Замість неї день показує&lt;br&gt;  ПРИРІСТ БОРГУ по точці: Σ intakes − Σ payouts дня.&lt;br&gt;&lt;br&gt;Ціна названа вголос: на питання «а за що саме ви мені&lt;br&gt;винні» система більше не відповідає рядком.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 · Мінус&lt;/b&gt;&lt;br&gt;&lt;br&gt;Виплата обрізана стелею min(Разом, каса), тому до&lt;br&gt;мінусу не доводить ніколи; сторно виплати борг лише&lt;br&gt;підіймає. ЄДИНИЙ шлях у мінус — сторно КВИТАНЦІЇ, на&lt;br&gt;яку вже видали гроші. Воно ДОЗВОЛЕНЕ, з попередженням:&lt;br&gt;заборони немає, і інваріанта «борг ≥ 0» в схемі теж&lt;br&gt;немає — обидва старі інваріанти були про розподіл.&lt;br&gt;&lt;br&gt;Мінус гаситься САМ наступною здачею, бо «Разом»&lt;br&gt;дорівнює балансу. Це частково повертає §3.8, який&lt;br&gt;правка 4 скасувала словами «Немає переплати», — але&lt;br&gt;тільки для мінусу зі сторно. Названо, не полагоджено.&lt;br&gt;&lt;br&gt;&lt;b&gt;5 · Стартового боргу немає&lt;/b&gt;&lt;br&gt;&lt;br&gt;Нижньої межі по датах у боргу немає і бути не може —&lt;br&gt;на відміну від каси з AppConfig.cashBookFrom.&lt;br&gt;Механізму «вступний залишок» НЕМАЄ навмисно: борг,&lt;br&gt;набутий до запуску, закривають по паперу поза&lt;br&gt;системою, а перший день показує всім нуль." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=11;fontColor=#1f2328;fillColor=#fbfcfd;strokeColor=#2a7f8f;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="2030" y="1928" width="560" height="740" as="geometry"/>
                </mxCell>
                <mxCell id="n_debt_c" value="&lt;b&gt;6 · Сторно: один void, два прочитання&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Виплати&lt;/b&gt; → борг САМ повертається до попередньої&lt;br&gt;суми. Готівка в касу при цьому НЕ повертається (§9.3):&lt;br&gt;під фізичне внесення слугує трійка payouts.&lt;br&gt;return_settled_at / return_settled_by_user_id /&lt;br&gt;return_note, і поки перше порожнє, каса лишається&lt;br&gt;зменшеною.&lt;br&gt;&lt;b&gt;Квитанції&lt;/b&gt; → вона випадає з боргу цілком, навіть&lt;br&gt;якщо гроші за неї вже видали — див. 4 · Мінус.&lt;br&gt;&lt;br&gt;У БОРЗІ сторнована виплата НЕ рахується; у КАСІ вона&lt;br&gt;рахується далі. Той самий voided_at у двох запитах&lt;br&gt;читається по-різному — інакше сторно стає способом&lt;br&gt;красти (§9.3).&lt;br&gt;&lt;br&gt;&lt;b&gt;7 · Історія нерухома, папір — ні&lt;/b&gt;&lt;br&gt;&lt;br&gt;intake.amount і payout.amount після проведення не&lt;br&gt;міняються НІКОЛИ (§2.7): на борг впливають рівно&lt;br&gt;поява документів і поля void_*.&lt;br&gt;&lt;br&gt;ВІДКРИТЕ, НАЗВАНЕ: надруковані «Разом», «видано» і&lt;br&gt;«залишок» не зберігаються ніде (§3.2), а стан на мить&lt;br&gt;друку відновлюється лише прокочуванням обох історій&lt;br&gt;до тієї позначки часу. Після сторно папір у руках&lt;br&gt;людини і база розходяться, і жодне поле цього не&lt;br&gt;тримає.&lt;br&gt;&lt;br&gt;&lt;b&gt;8 · Приклад&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Квитанції&amp;nbsp;2&amp;nbsp;000&amp;nbsp;+&amp;nbsp;3&amp;nbsp;000&amp;nbsp;+&amp;nbsp;500&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;борг&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;5&amp;nbsp;500,00&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Виплата&amp;nbsp;&amp;nbsp;&amp;nbsp;4&amp;nbsp;000,00&amp;nbsp;&amp;nbsp;борг&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;1&amp;nbsp;500,00&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Виплата&amp;nbsp;&amp;nbsp;&amp;nbsp;1&amp;nbsp;500,00&amp;nbsp;&amp;nbsp;борг&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0,00&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Сторно&amp;nbsp;квитанції&amp;nbsp;500,00&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;борг&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;−500,00&amp;nbsp;&amp;nbsp;⚠&lt;/font&gt;&lt;br&gt;Жоден рядок не каже, ЩО він закрив: питання «за яку&lt;br&gt;саме дату» більше не має відповіді — ні в базі, ні&lt;br&gt;на екрані." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=11;fontColor=#1f2328;fillColor=#fbfcfd;strokeColor=#2a7f8f;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="2630" y="1928" width="560" height="740" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>