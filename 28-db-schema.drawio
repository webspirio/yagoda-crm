        <mxCell id="e_628" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#8b93a1;strokeWidth=1.5;fontSize=10;fontColor=#4b5563;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r_563" target="r_258"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2042" y="1171"/><mxPoint x="2042" y="185"/></Array></mxGeometry></mxCell>
        <mxCell id="e_629" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#8b93a1;strokeWidth=1.5;fontSize=10;fontColor=#4b5563;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r_575" target="r_414"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2006" y="1365"/><mxPoint x="2006" y="1685"/></Array></mxGeometry></mxCell>
        <mxCell id="e_630" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#8b93a1;strokeWidth=1.5;fontSize=10;fontColor=#4b5563;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r_579" target="r_354"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2060" y="1391"/><mxPoint x="2060" y="1015"/></Array></mxGeometry></mxCell>
        <mxCell id="n_title" value="Ягода CRM — схема бази даних" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="n_sub" value="Чернетка з 28-db-schema.dbml. 17 таблиць, 33 зовнішні ключі, 3 enum-и. Правила — 26-rules-by-example.md." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1200" height="20" as="geometry"/></mxCell>
        <mxCell id="n_legend" value="&lt;b&gt;Як читати&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; — первинний ключ · &lt;i&gt;FK&lt;/i&gt; — зовнішній ключ&lt;br&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;?&lt;/font&gt; після назви — поле може бути порожнім (NULL)&lt;br&gt;· UQ — унікальне · = x — значення за замовчуванням&lt;br&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;◇&lt;/font&gt; — складений ключ або індекс&lt;br&gt;&lt;br&gt;Лінія: «лапка» = багато, «‖» = рівно один.&lt;br&gt;Читається від «лапки»: багато квитанцій —&lt;br&gt;в одного постачальника.&lt;br&gt;&lt;br&gt;&lt;b&gt;Колір заголовка = група&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4472c4&quot;&gt;■&lt;/font&gt; мережа: пункти, люди, зміни&lt;br&gt;&lt;font color=&quot;#c07b17&quot;&gt;■&lt;/font&gt; постачальник і довідник сіл&lt;br&gt;&lt;font color=&quot;#7a5b93&quot;&gt;■&lt;/font&gt; номенклатура і тара&lt;br&gt;&lt;font color=&quot;#4f9153&quot;&gt;■&lt;/font&gt; ціни зміни&lt;br&gt;&lt;font color=&quot;#2a7f8f&quot;&gt;■&lt;/font&gt; прийомка і виплати&lt;br&gt;&lt;font color=&quot;#a4573f&quot;&gt;■&lt;/font&gt; ящики&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;Колонка = глибина посилань, а не тип&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;таблиці: довідник стоїть праворуч, якщо&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#9aa0a6&quot;&gt;його читає лише сусід.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#374151;fillColor=#fbfcfd;strokeColor=#dfe3e8;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="350" height="420" as="geometry"/></mxCell>
        <mxCell id="n_fifo" value="&lt;b&gt;Дві таблиці розподілу — це два FIFO&lt;/b&gt;&lt;br&gt;payout_allocations — §3.3: виплата гасить найстаріший&lt;br&gt;борг першим і памʼятає, яку дату закрила.&lt;br&gt;crate_return_allocations — §6.5: повернення гасить&lt;br&gt;найстарішу видачу за ЇЇ ціною ящика, не сьогоднішньою." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#5b4a12;fillColor=#fdf8e3;strokeColor=#d9c56a;dashed=1;" vertex="1" parent="1"><mxGeometry x="940" y="210" width="350" height="115" as="geometry"/></mxCell>
        <mxCell id="n_snapshot" value="&lt;b&gt;Знімок, а не перерахунок (§2.7)&lt;/b&gt;&lt;br&gt;price, tare_weight_kg, deposit_per_unit копіюються&lt;br&gt;у документ у мить проведення. Керівник міняє довідник —&lt;br&gt;липнева квитанція і липнева видача не рухаються." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#5b4a12;fillColor=#fdf8e3;strokeColor=#d9c56a;dashed=1;" vertex="1" parent="1"><mxGeometry x="940" y="340" width="350" height="105" as="geometry"/></mxCell>
        <mxCell id="n_derived" value="&lt;b&gt;Чого тут немає навмисно&lt;/b&gt;&lt;br&gt;«Залишок» і «Разом» не зберігаються (§3.2): залишок =&lt;br&gt;amount − Σ payout_allocations. Полів під §5.4 і §5.5&lt;br&gt;(дублікати, обʼєднання) немає — правки 5 і 6 їх зняли." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontColor=#5b4a12;fillColor=#fdf8e3;strokeColor=#d9c56a;dashed=1;" vertex="1" parent="1"><mxGeometry x="940" y="460" width="350" height="105" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
